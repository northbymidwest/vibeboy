#version 450

// Scale3x — 3x pixel-art scaling (compute shader).

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, set = 0, binding = 0) readonly buffer PixelBuf {
    uint pixels[];
};

layout(set = 1, binding = 0, rgba8) writeonly uniform image2D output_img;

layout(std140, set = 2, binding = 0) uniform Uniforms {
    uint src_w;
    uint src_h;
    uint out_w;
    uint out_h;
};

vec4 unpack(uint c) {
    return vec4(
        float((c >> 16u) & 0xFFu) / 255.0,
        float((c >> 8u)  & 0xFFu) / 255.0,
        float( c         & 0xFFu) / 255.0,
        1.0
    );
}

vec4 fetch(ivec2 coord) {
    coord = clamp(coord, ivec2(0), ivec2(int(src_w) - 1, int(src_h) - 1));
    return unpack(pixels[coord.y * int(src_w) + coord.x]);
}

void main() {
    uint opx = gl_GlobalInvocationID.x;
    uint opy = gl_GlobalInvocationID.y;
    if (opx >= out_w || opy >= out_h) return;

    float inv_scale = float(src_w) / float(out_w);
    vec2 src_coord = (vec2(opx, opy) + 0.5) * inv_scale;
    ivec2 src_i = clamp(ivec2(floor(src_coord)), ivec2(0), ivec2(int(src_w) - 1, int(src_h) - 1));
    vec2 frac_val = src_coord - vec2(src_i);
    ivec2 sub = clamp(ivec2(floor(frac_val * 3.0)), ivec2(0), ivec2(2));

    vec4 a = fetch(src_i + ivec2(-1, -1));
    vec4 b = fetch(src_i + ivec2( 0, -1));
    vec4 c = fetch(src_i + ivec2( 1, -1));
    vec4 d = fetch(src_i + ivec2(-1,  0));
    vec4 e = fetch(src_i);
    vec4 f = fetch(src_i + ivec2( 1,  0));
    vec4 g = fetch(src_i + ivec2(-1,  1));
    vec4 h = fetch(src_i + ivec2( 0,  1));
    vec4 i = fetch(src_i + ivec2( 1,  1));

    vec4 result = e;

    if (b != h && d != f) {
        int idx = sub.y * 3 + sub.x;
        if      (idx == 0) result = (d == b) ? d : e;
        else if (idx == 1) result = ((d == b && e != c) || (b == f && e != a)) ? b : e;
        else if (idx == 2) result = (b == f) ? f : e;
        else if (idx == 3) result = ((d == b && e != g) || (d == h && e != a)) ? d : e;
        // idx == 4: center, stays e
        else if (idx == 5) result = ((b == f && e != i) || (h == f && e != c)) ? f : e;
        else if (idx == 6) result = (d == h) ? d : e;
        else if (idx == 7) result = ((d == h && e != i) || (h == f && e != g)) ? h : e;
        else               result = (h == f) ? f : e;
    }

    imageStore(output_img, ivec2(opx, opy), result);
}
