#version 450

// Scale3x — 3x pixel-art scaling (compute shader).
// Fixed 3x scale: output must be exactly src_w*3 x src_h*3.
// Comparisons use packed u32 colors for exact integer matching.

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, set = 0, binding = 0) readonly buffer PixelBuf {
    uint pixels[];
};

layout(set = 1, binding = 0, rgba8) writeonly uniform image2D output_img;

layout(std140, set = 2, binding = 0) uniform Uniforms {
    uint src_w;
    uint src_h;
    uint out_w;
    uint out_h;
};

uint fetch(ivec2 coord) {
    coord = clamp(coord, ivec2(0), ivec2(int(src_w) - 1, int(src_h) - 1));
    return pixels[coord.y * int(src_w) + coord.x];
}

vec4 unpack(uint c) {
    return vec4(
        float((c >> 16u) & 0xFFu) / 255.0,
        float((c >> 8u)  & 0xFFu) / 255.0,
        float( c         & 0xFFu) / 255.0,
        1.0
    );
}

void main() {
    uint opx = gl_GlobalInvocationID.x;
    uint opy = gl_GlobalInvocationID.y;
    if (opx >= out_w || opy >= out_h) return;

    int sx = int(opx) / 3;
    int sy = int(opy) / 3;
    int sub_x = int(opx) % 3;
    int sub_y = int(opy) % 3;
    int idx = sub_y * 3 + sub_x;

    ivec2 p = ivec2(sx, sy);
    uint a = fetch(p + ivec2(-1, -1));
    uint b = fetch(p + ivec2( 0, -1));
    uint c = fetch(p + ivec2( 1, -1));
    uint d = fetch(p + ivec2(-1,  0));
    uint e = fetch(p);
    uint f = fetch(p + ivec2( 1,  0));
    uint g = fetch(p + ivec2(-1,  1));
    uint h = fetch(p + ivec2( 0,  1));
    uint i = fetch(p + ivec2( 1,  1));

    uint result = e;

    if (b != h && d != f) {
        if      (idx == 0) result = (d == b) ? d : e;
        else if (idx == 1) result = ((d == b && e != c) || (b == f && e != a)) ? b : e;
        else if (idx == 2) result = (b == f) ? f : e;
        else if (idx == 3) result = ((d == b && e != g) || (d == h && e != a)) ? d : e;
        // idx == 4: center, stays e
        else if (idx == 5) result = ((b == f && e != i) || (h == f && e != c)) ? f : e;
        else if (idx == 6) result = (d == h) ? d : e;
        else if (idx == 7) result = ((d == h && e != i) || (h == f && e != g)) ? h : e;
        else               result = (h == f) ? f : e;
    }

    imageStore(output_img, ivec2(opx, opy), unpack(result));
}
