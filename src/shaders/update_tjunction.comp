#version 450

// Post-optimization T-junction position correction.
//
// Matches reference: UpdateCorrectedPositions.vert
// For each CP with IS_TJUNCTION flag, recompute position as:
//   pos = 0.125 * prev_pos + 0.75 * pos + 0.125 * next_pos
//
// This must run after the optimization pass so that neighbor positions
// reflect their optimized values.

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) buffer Positions {
    float positions[];
};

layout(std430, set = 0, binding = 1) readonly buffer Neighbors {
    int neighbor_data[];
};

layout(std430, set = 0, binding = 2) readonly buffer Flags {
    uint node_flags[];
};

layout(std140, set = 1, binding = 0) uniform Uniforms {
    uint num_nodes;
    uint _pad0;
    uint _pad1;
    uint _pad2;
};

const uint IS_TJUNCTION = 32u;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= num_nodes) return;

    uint flags = node_flags[i];
    if ((flags & IS_TJUNCTION) == 0u) return;

    int prev_idx = neighbor_data[i * 4u];
    int next_idx = neighbor_data[i * 4u + 1u];
    if (prev_idx < 0 || next_idx < 0) return;

    vec2 prev_pos = vec2(positions[uint(prev_idx) * 2u], positions[uint(prev_idx) * 2u + 1u]);
    vec2 curr_pos = vec2(positions[i * 2u], positions[i * 2u + 1u]);
    vec2 next_pos = vec2(positions[uint(next_idx) * 2u], positions[uint(next_idx) * 2u + 1u]);

    vec2 corrected = 0.125 * prev_pos + 0.75 * curr_pos + 0.125 * next_pos;
    positions[i * 2u] = corrected.x;
    positions[i * 2u + 1u] = corrected.y;

    // Update the stem CP at the other slot (i ^ 1) so it terminates
    // exactly ON the smooth curve. The curve at t=0.5 is the closest
    // point to the CP: beval(prev, corrected, next, 0.5).
    uint stem = i ^ 1u;
    if (stem < num_nodes && node_flags[stem] == 1u) {
        vec2 on_curve = 0.125 * prev_pos + 0.75 * corrected + 0.125 * next_pos;
        positions[stem * 2u] = on_curve.x;
        positions[stem * 2u + 1u] = on_curve.y;
    }
}
