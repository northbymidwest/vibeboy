#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, set = 0, binding = 0) readonly buffer PixelBuf { uint pixels[]; };
layout(set = 1, binding = 0, rgba8) writeonly uniform image2D output_img;
layout(std140, set = 2, binding = 0) uniform Uniforms {
    uint src_w;
    uint src_h;
    uint out_w;
    uint out_h;
    uint iscale;
    uint _pad0;
    uint _pad1;
    uint _pad2;
};

// ── I/O helpers ─────────────────────────────────────────────────────────────

vec4 unpack(uint c) {
    return vec4(float((c >> 16u) & 0xFFu) / 255.0, float((c >> 8u) & 0xFFu) / 255.0, float(c & 0xFFu) / 255.0, 1.0);
}

vec4 fetch(ivec2 coord) {
    coord = clamp(coord, ivec2(0), ivec2(int(src_w) - 1, int(src_h) - 1));
    return unpack(pixels[coord.y * int(src_w) + coord.x]);
}

// ── Helpers ─────────────────────────────────────────────────────────────────

bool colors_differ(vec4 a, vec4 b) {
    vec3 d = (a.rgb - b.rgb) * 255.0;
    // BT.601 YUV with individual thresholds (matching CPU hqx.rs)
    float dy = abs(0.299 * d.r + 0.587 * d.g + 0.114 * d.b);
    float du = abs(-0.169 * d.r - 0.331 * d.g + 0.500 * d.b);
    float dv = abs(0.500 * d.r - 0.419 * d.g - 0.081 * d.b);
    return dy > 48.0 || du > 7.0 || dv > 6.0;
}

vec4 mix2(vec4 c1, float w1, vec4 c2, float w2) {
    return vec4((c1.rgb * w1 + c2.rgb * w2) / (w1 + w2), 1.0);
}

vec4 mix3(vec4 c1, float w1, vec4 c2, float w2, vec4 c3, float w3) {
    return vec4((c1.rgb * w1 + c2.rgb * w2 + c3.rgb * w3) / (w1 + w2 + w3), 1.0);
}

// ── Corner view ─────────────────────────────────────────────────────────────

struct CornerView {
    int edge;
    vec4 diag;
    vec4 top;
    vec4 left;
    vec4 center;
    vec4 right;
    vec4 bot;
};

// Symmetry transforms (index permutations for 4 corners)
const int TRANSFORMS[4*9] = int[](
    0,1,2,3,4,5,6,7,8,  // top-left (identity)
    2,1,0,5,4,3,8,7,6,  // top-right (flip x)
    6,7,8,3,4,5,0,1,2,  // bottom-left (flip y)
    8,7,6,5,4,3,2,1,0   // bottom-right (flip both)
);

// Rotations for hq3x edge pixels
const int ROTATIONS[4*9] = int[](
    0,1,2,3,4,5,6,7,8,  // 0 degrees
    2,5,8,1,4,7,0,3,6,  // 90 CW
    6,3,0,7,4,1,8,5,2,  // 90 CCW
    8,7,6,5,4,3,2,1,0   // 180
);

// ── Module-scope globals for array parameters (naga WGSL compatibility) ────
vec4 g_nb[9];
int g_indices[8] = int[](0,1,2,3,5,6,7,8);

int remap_edge_pattern(int pattern, int perm_offset, bool reverse) {
    int result = 0;
    for (int i = 0; i < 8; i++) {
        int idx = g_indices[i];
        int src_idx = (perm_offset >= 0) ?
            TRANSFORMS[perm_offset + idx] : ROTATIONS[(-perm_offset - 1) + idx];
        int src_bit = src_idx > 4 ? src_idx - 1 : src_idx;
        int actual_bit = reverse ? 7 - src_bit : src_bit;
        result |= ((pattern >> actual_bit) & 1) << i;
    }
    return result;
}

CornerView build_view(int pattern, int perm_offset, bool reverse) {
    int edge = remap_edge_pattern(pattern, perm_offset, reverse);
    int p0, p1, p3, p4, p5, p7;
    if (perm_offset >= 0) {
        p0 = TRANSFORMS[perm_offset]; p1 = TRANSFORMS[perm_offset+1];
        p3 = TRANSFORMS[perm_offset+3]; p4 = TRANSFORMS[perm_offset+4];
        p5 = TRANSFORMS[perm_offset+5]; p7 = TRANSFORMS[perm_offset+7];
    } else {
        int off = -perm_offset - 1;
        p0 = ROTATIONS[off]; p1 = ROTATIONS[off+1];
        p3 = ROTATIONS[off+3]; p4 = ROTATIONS[off+4];
        p5 = ROTATIONS[off+5]; p7 = ROTATIONS[off+7];
    }
    return CornerView(edge, g_nb[p0], g_nb[p1], g_nb[p3], g_nb[p4], g_nb[p5], g_nb[p7]);
}

// ── Edge pattern helpers ────────────────────────────────────────────────────

bool em(CornerView v, int mask, int expected) { return (v.edge & mask) == expected; }

bool edge_horiz(CornerView v) { return em(v,0xbf,0x37) || em(v,0xdb,0x13); }
bool edge_vert(CornerView v) { return em(v,0xdb,0x49) || em(v,0xef,0x6d); }
bool edge_sharp(CornerView v) { return em(v,0x0b,0x0b) || em(v,0xfe,0x4a) || em(v,0xfe,0x1a); }

bool edge_partial(CornerView v) {
    return em(v,0x6f,0x2a)||em(v,0x5b,0x0a)||em(v,0xbf,0x3a)||em(v,0xdf,0x5a)||
           em(v,0x9f,0x8a)||em(v,0xcf,0x8a)||em(v,0xef,0x4e)||em(v,0x3f,0x0e)||
           em(v,0xfb,0x5a)||em(v,0xbb,0x8a)||em(v,0x7f,0x5a)||em(v,0xaf,0x8a)||em(v,0xeb,0x8a);
}

// ── hq2x corner ─────────────────────────────────────────────────────────────

vec4 hq2x_corner(CornerView v) {
    vec4 D=v.diag, T=v.top, L=v.left, C=v.center, R=v.right, B=v.bot;
    if (edge_horiz(v) && colors_differ(T,R)) return mix2(C,3.0,L,1.0);
    if (edge_vert(v) && colors_differ(B,L)) return mix2(C,3.0,T,1.0);
    if (edge_sharp(v) && colors_differ(L,T)) return C;
    if (edge_partial(v) && colors_differ(L,T)) return mix2(C,3.0,D,1.0);
    if (em(v,0x0b,0x08)) return mix3(C,2.0,D,1.0,T,1.0);
    if (em(v,0x0b,0x02)) return mix3(C,2.0,D,1.0,L,1.0);
    if (em(v,0x2f,0x2f)) return mix3(C,14.0,L,1.0,T,1.0);
    if (edge_horiz(v)) return mix3(C,5.0,T,2.0,L,1.0);
    if (edge_vert(v)) return mix3(C,5.0,L,2.0,T,1.0);
    if (em(v,0x1b,0x03)||em(v,0x4f,0x43)||em(v,0x8b,0x83)||em(v,0x6b,0x43)) return mix2(C,3.0,L,1.0);
    if (em(v,0x4b,0x09)||em(v,0x8b,0x89)||em(v,0x1f,0x19)||em(v,0x3b,0x19)) return mix2(C,3.0,T,1.0);
    if (em(v,0x7e,0x2a)||em(v,0xef,0xab)||em(v,0xbf,0x8f)||em(v,0x7e,0x0e)) return mix3(C,2.0,L,3.0,T,3.0);
    if (em(v,0xfb,0x6a)||em(v,0x6f,0x6e)||em(v,0x3f,0x3e)||em(v,0xfb,0xfa)||em(v,0xdf,0xde)||em(v,0xdf,0x1e)) return mix2(C,3.0,D,1.0);
    if (em(v,0x0a,0x00)||em(v,0x4f,0x4b)||em(v,0x9f,0x1b)||em(v,0x2f,0x0b)||em(v,0xbe,0x0a)||em(v,0xee,0x0a)||em(v,0x7e,0x0a)||em(v,0xeb,0x4b)||em(v,0x3b,0x1b)) return mix3(C,2.0,L,1.0,T,1.0);
    return mix3(C,6.0,L,1.0,T,1.0);
}

// ── hq3x corner + edge ──────────────────────────────────────────────────────

// Out parameters via globals for naga compatibility
vec4 g_hq3x_corner;
vec4 g_hq3x_edge;

void hq3x_corner_and_edge(CornerView v) {
    vec4 D=v.diag, T=v.top, L=v.left, C=v.center, R=v.right, B=v.bot;

    if (edge_vert(v) && colors_differ(B,L)) g_hq3x_corner = mix2(C,3.0,T,1.0);
    else if (edge_horiz(v) && colors_differ(T,R)) g_hq3x_corner = mix2(C,3.0,L,1.0);
    else if (edge_sharp(v) && colors_differ(L,T)) g_hq3x_corner = C;
    else if (edge_partial(v) && colors_differ(L,T)) g_hq3x_corner = mix2(C,3.0,D,1.0);
    else if (em(v,0x4b,0x09)||em(v,0x8b,0x89)||em(v,0x1f,0x19)||em(v,0x3b,0x19)) g_hq3x_corner = mix2(C,3.0,T,1.0);
    else if (em(v,0x1b,0x03)||em(v,0x4f,0x43)||em(v,0x8b,0x83)||em(v,0x6b,0x43)) g_hq3x_corner = mix2(C,3.0,L,1.0);
    else if (em(v,0x7e,0x2a)||em(v,0xef,0xab)||em(v,0xbf,0x8f)||em(v,0x7e,0x0e)) g_hq3x_corner = mix2(L,1.0,T,1.0);
    else if (em(v,0x4f,0x4b)||em(v,0x9f,0x1b)||em(v,0x2f,0x0b)||em(v,0xbe,0x0a)||em(v,0xee,0x0a)||em(v,0x7e,0x0a)||em(v,0xeb,0x4b)||em(v,0x3b,0x1b)) g_hq3x_corner = mix3(C,2.0,L,7.0,T,7.0);
    else if (em(v,0x0b,0x08)||em(v,0xf9,0x68)||em(v,0xf3,0x62)||em(v,0x6d,0x6c)||em(v,0x67,0x66)||em(v,0x3d,0x3c)||em(v,0x37,0x36)||em(v,0xf9,0xf8)||em(v,0xdd,0xdc)||em(v,0xf3,0xf2)||em(v,0xd7,0xd6)||em(v,0xdd,0x1c)||em(v,0xd7,0x16)||em(v,0x0b,0x02)) g_hq3x_corner = mix2(C,3.0,D,1.0);
    else g_hq3x_corner = mix3(C,2.0,L,1.0,T,1.0);

    if ((em(v,0xfe,0xde)||em(v,0x9e,0x16)||em(v,0xda,0x12)||em(v,0x17,0x16)||em(v,0x5b,0x12)||em(v,0xbb,0x12)) && colors_differ(T,R)) g_hq3x_edge = C;
    else if ((em(v,0x0f,0x0b)||em(v,0x5e,0x0a)||em(v,0xfb,0x7b)||em(v,0x3b,0x0b)||em(v,0xbe,0x0a)||em(v,0x7a,0x0a)) && colors_differ(L,T)) g_hq3x_edge = C;
    else if (em(v,0xbf,0x8f)||em(v,0x7e,0x0e)||em(v,0xbf,0x37)||em(v,0xdb,0x13)) g_hq3x_edge = mix2(T,3.0,C,1.0);
    else if (em(v,0x02,0x00)||em(v,0x7c,0x28)||em(v,0xed,0xa9)||em(v,0xf5,0xb4)||em(v,0xd9,0x90)) g_hq3x_edge = mix2(C,3.0,T,1.0);
    else if (em(v,0x4f,0x4b)||em(v,0xfb,0x7b)||em(v,0xfe,0x7e)||em(v,0x9f,0x1b)||em(v,0x2f,0x0b)||em(v,0xbe,0x0a)||em(v,0x7e,0x0a)||em(v,0xfb,0x4b)||em(v,0xfb,0xdb)||em(v,0xfe,0xde)||em(v,0xfe,0x56)||em(v,0x57,0x56)||em(v,0x97,0x16)||em(v,0x3f,0x1e)||em(v,0xdb,0x12)||em(v,0xbb,0x12)) g_hq3x_edge = mix2(C,7.0,T,1.0);
    else g_hq3x_edge = C;
}

// ── hq4x quadrant ───────────────────────────────────────────────────────────

// Out parameters via globals for naga compatibility
vec4 g_hq4x_px00;
vec4 g_hq4x_px01;
vec4 g_hq4x_px10;
vec4 g_hq4x_px11;

void hq4x_quadrant(CornerView v) {
    vec4 D=v.diag, T=v.top, L=v.left, C=v.center, R=v.right, B=v.bot;
    bool h_edge = edge_horiz(v) && colors_differ(T,R);
    bool v_edge = edge_vert(v) && colors_differ(B,L);
    bool p_diag = edge_partial(v) && colors_differ(L,T);
    bool h_vert = edge_vert(v), h_horiz = edge_horiz(v);
    bool l_edge = em(v,0x1b,0x03)||em(v,0x4f,0x43)||em(v,0x8b,0x83)||em(v,0x6b,0x43);
    bool t_edge = em(v,0x4b,0x09)||em(v,0x8b,0x89)||em(v,0x1f,0x19)||em(v,0x3b,0x19);
    bool n_diag = em(v,0x0b,0x08)||em(v,0xf9,0x68)||em(v,0xf3,0x62)||em(v,0x6d,0x6c)||em(v,0x67,0x66)||em(v,0x3d,0x3c)||em(v,0x37,0x36)||em(v,0xf9,0xf8)||em(v,0xdd,0xdc)||em(v,0xf3,0xf2)||em(v,0xd7,0xd6)||em(v,0xdd,0x1c)||em(v,0xd7,0x16)||em(v,0x0b,0x02);
    bool sharp = edge_sharp(v) && colors_differ(L,T);
    bool cross = (em(v,0x0f,0x0b)||em(v,0x2b,0x0b)||em(v,0xfe,0x4a)||em(v,0xfe,0x1a)) && colors_differ(L,T);
    bool a_diff = em(v,0x2f,0x2f);
    bool smth = em(v,0x0a,0x00);
    bool i_top = em(v,0x0b,0x09);
    bool da = em(v,0x7e,0x2a)||em(v,0xef,0xab);
    bool db = em(v,0xbf,0x8f)||em(v,0x7e,0x0e);
    bool grad = em(v,0x4f,0x4b)||em(v,0x9f,0x1b)||em(v,0x2f,0x0b)||em(v,0xbe,0x0a)||em(v,0xee,0x0a)||em(v,0x7e,0x0a)||em(v,0xeb,0x4b)||em(v,0x3b,0x1b);
    bool i_left = em(v,0x0b,0x03);

    if (h_edge) g_hq4x_px00=mix2(C,5.0,L,3.0); else if (v_edge) g_hq4x_px00=mix2(C,5.0,T,3.0); else if (sharp) g_hq4x_px00=C; else if (p_diag) g_hq4x_px00=mix2(C,5.0,D,3.0); else if (h_vert) g_hq4x_px00=mix2(C,3.0,L,1.0); else if (h_horiz) g_hq4x_px00=mix2(C,3.0,T,1.0); else if (l_edge) g_hq4x_px00=mix2(C,5.0,L,3.0); else if (t_edge) g_hq4x_px00=mix2(C,5.0,T,3.0); else if (em(v,0x0f,0x0b)||em(v,0x5e,0x0a)||em(v,0x2b,0x0b)||em(v,0xbe,0x0a)||em(v,0x7a,0x0a)||em(v,0xee,0x0a)) g_hq4x_px00=mix2(T,1.0,L,1.0); else if (n_diag) g_hq4x_px00=mix2(C,5.0,D,3.0); else g_hq4x_px00=mix3(C,2.0,T,1.0,L,1.0);

    if (h_edge) g_hq4x_px01=mix2(C,7.0,L,1.0); else if (cross) g_hq4x_px01=C; else if (p_diag) g_hq4x_px01=mix2(C,3.0,D,1.0); else if (a_diff) g_hq4x_px01=C; else if (smth) g_hq4x_px01=mix3(C,5.0,T,2.0,L,1.0); else if (em(v,0x0b,0x08)) g_hq4x_px01=mix3(C,5.0,T,2.0,D,1.0); else if (i_top) g_hq4x_px01=mix2(C,5.0,T,3.0); else if (h_horiz) g_hq4x_px01=mix2(T,3.0,C,1.0); else if (da) g_hq4x_px01=mix3(T,2.0,C,1.0,L,1.0); else if (db) g_hq4x_px01=mix2(T,5.0,L,3.0); else if (l_edge) g_hq4x_px01=mix2(C,7.0,L,1.0); else if (em(v,0xf3,0x62)||em(v,0x67,0x66)||em(v,0x37,0x36)||em(v,0xf3,0xf2)||em(v,0xd7,0xd6)||em(v,0xd7,0x16)||em(v,0x0b,0x02)) g_hq4x_px01=mix2(C,3.0,D,1.0); else if (grad) g_hq4x_px01=mix2(T,1.0,C,1.0); else g_hq4x_px01=mix2(C,3.0,T,1.0);

    if (v_edge) g_hq4x_px10=mix2(C,7.0,T,1.0); else if (cross) g_hq4x_px10=C; else if (p_diag) g_hq4x_px10=mix2(C,3.0,D,1.0); else if (a_diff) g_hq4x_px10=C; else if (smth) g_hq4x_px10=mix3(C,5.0,L,2.0,T,1.0); else if (em(v,0x0b,0x02)) g_hq4x_px10=mix3(C,5.0,L,2.0,D,1.0); else if (i_left) g_hq4x_px10=mix2(C,5.0,L,3.0); else if (h_vert) g_hq4x_px10=mix2(L,3.0,C,1.0); else if (db) g_hq4x_px10=mix3(L,2.0,C,1.0,T,1.0); else if (da) g_hq4x_px10=mix2(L,5.0,T,3.0); else if (t_edge) g_hq4x_px10=mix2(C,7.0,T,1.0); else if (em(v,0x0b,0x08)||em(v,0xf9,0x68)||em(v,0x6d,0x6c)||em(v,0x3d,0x3c)||em(v,0xf9,0xf8)||em(v,0xdd,0xdc)||em(v,0xdd,0x1c)) g_hq4x_px10=mix2(C,3.0,D,1.0); else if (grad) g_hq4x_px10=mix2(L,1.0,C,1.0); else g_hq4x_px10=mix2(C,3.0,L,1.0);

    if ((em(v,0x7f,0x2b)||em(v,0xef,0xab)||em(v,0xbf,0x8f)||em(v,0x7f,0x0f)) && colors_differ(L,T)) g_hq4x_px11=C; else if (p_diag) g_hq4x_px11=mix2(C,7.0,D,1.0); else if (i_left) g_hq4x_px11=mix2(C,7.0,L,1.0); else if (i_top) g_hq4x_px11=mix2(C,7.0,T,1.0); else if (smth||em(v,0x7e,0x2a)||em(v,0xef,0xab)||em(v,0xbf,0x8f)||em(v,0x7e,0x0e)) g_hq4x_px11=mix3(C,6.0,L,1.0,T,1.0); else if (n_diag) g_hq4x_px11=mix2(C,7.0,D,1.0); else g_hq4x_px11=C;
}

// ── Main ────────────────────────────────────────────────────────────────────

void main() {
    uint opx = gl_GlobalInvocationID.x;
    uint opy = gl_GlobalInvocationID.y;
    if (opx >= out_w || opy >= out_h) return;

    // Integer mapping: output pixel to source pixel + sub-pixel position
    int is = int(iscale);
    ivec2 out_pos = ivec2(opx, opy);
    ivec2 src_i = clamp(out_pos / is, ivec2(0), ivec2(int(src_w) - 1, int(src_h) - 1));
    ivec2 sub = out_pos - src_i * is;

    // Sample 3x3 neighborhood into global array
    g_nb[0]=fetch(src_i+ivec2(-1,-1)); g_nb[1]=fetch(src_i+ivec2(0,-1)); g_nb[2]=fetch(src_i+ivec2(1,-1));
    g_nb[3]=fetch(src_i+ivec2(-1, 0)); g_nb[4]=fetch(src_i);             g_nb[5]=fetch(src_i+ivec2(1, 0));
    g_nb[6]=fetch(src_i+ivec2(-1, 1)); g_nb[7]=fetch(src_i+ivec2(0, 1)); g_nb[8]=fetch(src_i+ivec2(1, 1));

    // Compute edge pattern
    int pat = 0;
    if (colors_differ(g_nb[4],g_nb[0])) pat |= 1;
    if (colors_differ(g_nb[4],g_nb[1])) pat |= 2;
    if (colors_differ(g_nb[4],g_nb[2])) pat |= 4;
    if (colors_differ(g_nb[4],g_nb[3])) pat |= 8;
    if (colors_differ(g_nb[4],g_nb[5])) pat |= 16;
    if (colors_differ(g_nb[4],g_nb[6])) pat |= 32;
    if (colors_differ(g_nb[4],g_nb[7])) pat |= 64;
    if (colors_differ(g_nb[4],g_nb[8])) pat |= 128;

    vec4 result;

    if (is == 2) {
        // hq2x: each output pixel is one corner, selected by sub-pixel position
        int ti = sub.y * 2 + sub.x;
        CornerView v = build_view(pat, ti * 9, false);
        result = hq2x_corner(v);

    } else if (is == 3) {
        // hq3x: center pixel unchanged, corners and edges via rotated views.
        if (sub.x == 1 && sub.y == 1) {
            result = g_nb[4];
        } else {
            if (sub.y == 0 && sub.x <= 1) {
                hq3x_corner_and_edge(build_view(pat, -1, false));
                result = (sub.x == 0) ? g_hq3x_corner : g_hq3x_edge;
            } else if (sub.x == 2 && sub.y <= 1) {
                hq3x_corner_and_edge(build_view(pat, -10, true));
                result = (sub.y == 0) ? g_hq3x_corner : g_hq3x_edge;
            } else if (sub.x == 0 && sub.y >= 1) {
                hq3x_corner_and_edge(build_view(pat, -19, true));
                result = (sub.y == 2) ? g_hq3x_corner : g_hq3x_edge;
            } else {
                hq3x_corner_and_edge(build_view(pat, -28, false));
                result = (sub.x == 2) ? g_hq3x_corner : g_hq3x_edge;
            }
        }

    } else {
        // hq4x: each quadrant is a 2x2 block
        int qx = sub.x < 2 ? 0 : 1;
        int qy = sub.y < 2 ? 0 : 1;
        int ti = qy * 2 + qx;
        hq4x_quadrant(build_view(pat, ti * 9, false));
        int lx = qx == 0 ? sub.x : 3 - sub.x;
        int ly = qy == 0 ? sub.y : 3 - sub.y;
        result = (ly==0 && lx==0) ? g_hq4x_px00 : (ly==0) ? g_hq4x_px01 : (lx==0) ? g_hq4x_px10 : g_hq4x_px11;
    }

    imageStore(output_img, ivec2(opx, opy), result);
}
