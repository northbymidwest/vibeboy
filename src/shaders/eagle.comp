#version 450

// Eagle — 2x pixel-art scaling (compute shader).
// Comparisons use packed u32 colors for exact integer matching.

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, set = 0, binding = 0) readonly buffer PixelBuf {
    uint pixels[];
};

layout(set = 1, binding = 0, rgba8) writeonly uniform image2D output_img;

layout(std140, set = 2, binding = 0) uniform Uniforms {
    uint src_w;
    uint src_h;
    uint out_w;
    uint out_h;
};

vec4 unpack(uint c) {
    return vec4(
        float((c >> 16u) & 0xFFu) / 255.0,
        float((c >> 8u)  & 0xFFu) / 255.0,
        float( c         & 0xFFu) / 255.0,
        1.0
    );
}

uint fetch(ivec2 coord) {
    coord = clamp(coord, ivec2(0), ivec2(int(src_w) - 1, int(src_h) - 1));
    return pixels[coord.y * int(src_w) + coord.x];
}

void main() {
    uint opx = gl_GlobalInvocationID.x;
    uint opy = gl_GlobalInvocationID.y;
    if (opx >= out_w || opy >= out_h) return;

    // Integer mapping: fixed 2x scale
    ivec2 out_pos = ivec2(opx, opy);
    ivec2 src_i = clamp(out_pos / 2, ivec2(0), ivec2(int(src_w) - 1, int(src_h) - 1));
    ivec2 sub = out_pos - src_i * 2;

    uint p = fetch(src_i);
    uint s = fetch(src_i + ivec2(-1, -1));
    uint t = fetch(src_i + ivec2( 0, -1));
    uint u = fetch(src_i + ivec2( 1, -1));
    uint v = fetch(src_i + ivec2(-1,  0));
    uint w = fetch(src_i + ivec2( 1,  0));
    uint x = fetch(src_i + ivec2(-1,  1));
    uint y = fetch(src_i + ivec2( 0,  1));
    uint z = fetch(src_i + ivec2( 1,  1));

    uint result;
    if      (sub.x == 0 && sub.y == 0) result = (s==t && s==v) ? s : p;
    else if (sub.x == 1 && sub.y == 0) result = (t==u && u==w) ? u : p;
    else if (sub.x == 0 && sub.y == 1) result = (v==x && x==y) ? x : p;
    else                               result = (w==z && z==y) ? z : p;

    imageStore(output_img, ivec2(opx, opy), unpack(result));
}
