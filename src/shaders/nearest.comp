#version 450

// Nearest-neighbor scaling compute shader.

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, set = 0, binding = 0) readonly buffer PixelBuf {
    uint pixels[];
};

layout(set = 1, binding = 0, rgba8) writeonly uniform image2D output_img;

layout(std140, set = 2, binding = 0) uniform Uniforms {
    uint src_w;
    uint src_h;
    uint out_w;
    uint out_h;
};

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= int(out_w) || pos.y >= int(out_h)) return;

    int sx = clamp(int(float(pos.x) * float(src_w) / float(out_w)), 0, int(src_w) - 1);
    int sy = clamp(int(float(pos.y) * float(src_h) / float(out_h)), 0, int(src_h) - 1);
    uint c = pixels[sy * int(src_w) + sx];

    vec4 rgba = vec4(
        float((c >> 16u) & 0xFFu) / 255.0,
        float((c >> 8u)  & 0xFFu) / 255.0,
        float( c         & 0xFFu) / 255.0,
        1.0
    );
    imageStore(output_img, pos, rgba);
}
