#version 450

layout(local_size_x = 16, local_size_y = 16) in;

// SDL3 SPIRV compute: set 0 = readonly storage buffers (no sampled/storage textures before them)
layout(std430, set = 0, binding = 0) readonly buffer EdgeBuf {
    // Each edge: x0, y0, dx_per_dy, y_min, y_max, dir(int), color(uint), _pad(uint)
    // Laid out as 8 floats per edge (32 bytes), with dir/color/pad reinterpreted
    float edge_data[];
};

layout(std430, set = 0, binding = 1) readonly buffer RowRangeBuf {
    // Each row: start(uint), count(uint)
    uint row_data[];
};

layout(std430, set = 0, binding = 2) readonly buffer EdgeIndexBuf {
    uint edge_indices[];
};

// SDL3 SPIRV compute: set 1 = readwrite storage textures
layout(set = 1, binding = 0, rgba8) writeonly uniform image2D output_img;

// SDL3 SPIRV compute: set 2 = uniform buffers
layout(std140, set = 2, binding = 0) uniform Uniforms {
    uint out_w;
    uint out_h;
    uint num_edges;
    uint bg_color;
};

// Edge field accessors (32 bytes per edge = 8 floats)
float edge_x0(uint i)       { return edge_data[i * 8u + 0u]; }
float edge_y0(uint i)       { return edge_data[i * 8u + 1u]; }
float edge_dx_per_dy(uint i){ return edge_data[i * 8u + 2u]; }
float edge_y_min(uint i)    { return edge_data[i * 8u + 3u]; }
float edge_y_max(uint i)    { return edge_data[i * 8u + 4u]; }
int   edge_dir(uint i)      { return floatBitsToInt(edge_data[i * 8u + 5u]); }
uint  edge_color(uint i)    { return floatBitsToUint(edge_data[i * 8u + 6u]); }

// Row range accessors (8 bytes per row = 2 uints)
uint row_start(uint r) { return row_data[r * 2u]; }
uint row_count(uint r) { return row_data[r * 2u + 1u]; }

uint unpack_channel(uint color, uint shift) {
    return (color >> shift) & 0xFFu;
}

uint blend_over(uint bg, uint fg, uint fg_coverage, uint total) {
    uint inv = total - fg_coverage;
    uint r = (unpack_channel(bg, 16u) * inv + unpack_channel(fg, 16u) * fg_coverage) / total;
    uint g = (unpack_channel(bg, 8u) * inv + unpack_channel(fg, 8u) * fg_coverage) / total;
    uint b = (unpack_channel(bg, 0u) * inv + unpack_channel(fg, 0u) * fg_coverage) / total;
    return 0xFF000000u | (r << 16u) | (g << 8u) | b;
}

void main() {
    uint px = gl_GlobalInvocationID.x;
    uint py = gl_GlobalInvocationID.y;
    if (px >= out_w || py >= out_h) {
        return;
    }

    uint color = bg_color;
    float x_left = float(px);

    // 2x2 supersampling sample points
    float sy0 = float(py) + 0.25;
    float sy1 = float(py) + 0.75;
    float sx0 = x_left + 0.25;
    float sx1 = x_left + 0.75;

    // Get edges that overlap this pixel's row
    uint r_start = row_start(py);
    uint r_count = row_count(py);

    uint prev_color = 0xFFFFFFFFu;
    int w00 = 0, w10 = 0, w01 = 0, w11 = 0;

    for (uint ri = 0u; ri < r_count; ri++) {
        uint ei = edge_indices[r_start + ri];

        float e_x0 = edge_x0(ei);
        float e_y0 = edge_y0(ei);
        float e_dx = edge_dx_per_dy(ei);
        float e_ymin = edge_y_min(ei);
        float e_ymax = edge_y_max(ei);
        int e_dir = edge_dir(ei);
        uint e_color = edge_color(ei);

        // When we hit a new path (color), composite the previous one
        if (e_color != prev_color && prev_color != 0xFFFFFFFFu) {
            uint coverage = 0u;
            if (w00 != 0) coverage++;
            if (w10 != 0) coverage++;
            if (w01 != 0) coverage++;
            if (w11 != 0) coverage++;
            if (coverage == 4u) {
                color = prev_color;
            } else if (coverage > 0u) {
                color = blend_over(color, prev_color, coverage, 4u);
            }
            w00 = 0; w10 = 0; w01 = 0; w11 = 0;
        }
        prev_color = e_color;

        // Row 0 (sy = y + 0.25)
        if (sy0 >= e_ymin && sy0 < e_ymax) {
            float ix = e_x0 + (sy0 - e_y0) * e_dx;
            if (sx0 < ix) w00 += e_dir;
            if (sx1 < ix) w10 += e_dir;
        }

        // Row 1 (sy = y + 0.75)
        if (sy1 >= e_ymin && sy1 < e_ymax) {
            float ix = e_x0 + (sy1 - e_y0) * e_dx;
            if (sx0 < ix) w01 += e_dir;
            if (sx1 < ix) w11 += e_dir;
        }
    }

    // Composite final path
    if (prev_color != 0xFFFFFFFFu) {
        uint coverage = 0u;
        if (w00 != 0) coverage++;
        if (w10 != 0) coverage++;
        if (w01 != 0) coverage++;
        if (w11 != 0) coverage++;
        if (coverage == 4u) {
            color = prev_color;
        } else if (coverage > 0u) {
            color = blend_over(color, prev_color, coverage, 4u);
        }
    }

    // Write to texture
    vec4 rgba = vec4(
        float((color >> 16u) & 0xFFu) / 255.0,
        float((color >> 8u) & 0xFFu) / 255.0,
        float(color & 0xFFu) / 255.0,
        1.0
    );
    imageStore(output_img, ivec2(gl_GlobalInvocationID.xy), rgba);
}
