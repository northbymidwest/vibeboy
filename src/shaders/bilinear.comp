#version 450

// Bilinear scaling compute shader.

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, set = 0, binding = 0) readonly buffer PixelBuf {
    uint pixels[];
};

layout(set = 1, binding = 0, rgba8) writeonly uniform image2D output_img;

layout(std140, set = 2, binding = 0) uniform Uniforms {
    uint src_w;
    uint src_h;
    uint out_w;
    uint out_h;
};

vec3 fetch_rgb(ivec2 coord) {
    coord = clamp(coord, ivec2(0), ivec2(int(src_w) - 1, int(src_h) - 1));
    uint c = pixels[coord.y * int(src_w) + coord.x];
    return vec3(
        float((c >> 16u) & 0xFFu) / 255.0,
        float((c >> 8u)  & 0xFFu) / 255.0,
        float( c         & 0xFFu) / 255.0
    );
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= int(out_w) || pos.y >= int(out_h)) return;

    // Map output pixel to source coordinates
    float sx = (float(pos.x) + 0.5) * float(src_w) / float(out_w) - 0.5;
    float sy = (float(pos.y) + 0.5) * float(src_h) / float(out_h) - 0.5;

    int x0 = int(floor(sx));
    int y0 = int(floor(sy));
    float fx = sx - float(x0);
    float fy = sy - float(y0);

    vec3 c00 = fetch_rgb(ivec2(x0,     y0));
    vec3 c10 = fetch_rgb(ivec2(x0 + 1, y0));
    vec3 c01 = fetch_rgb(ivec2(x0,     y0 + 1));
    vec3 c11 = fetch_rgb(ivec2(x0 + 1, y0 + 1));

    vec3 color = mix(mix(c00, c10, fx), mix(c01, c11, fx), fy);

    imageStore(output_img, pos, vec4(color, 1.0));
}
