#version 450

layout(local_size_x = 16, local_size_y = 16) in;

// SDL3 SPIRV compute: set 0 = readonly storage buffers
layout(std430, set = 0, binding = 0) readonly buffer PixelBuf {
    uint src_pixels[];
};

layout(std430, set = 0, binding = 1) readonly buffer RegionBuf {
    uint src_regions[];
};

// Packed diagonal states: 4 corner states per source pixel, packed into 1 uint.
// Bits [1:0] = TL, [3:2] = TR, [5:4] = BR, [7:6] = BL.
// Each 2-bit value: 0 = no diagonal, 1 = backslash, 2 = slash.
layout(std430, set = 0, binding = 2) readonly buffer DiagBuf {
    uint diag_states[];
};

// SDL3 SPIRV compute: set 1 = readwrite storage textures
layout(set = 1, binding = 0, rgba8) writeonly uniform image2D output_img;

// SDL3 SPIRV compute: set 2 = uniform buffers
layout(std140, set = 2, binding = 0) uniform Uniforms {
    uint out_w;
    uint out_h;
    uint src_w;
    uint src_h;
    float inv_scale;
    float gauss_k;
    float radius;
    uint _pad;
};

// Unpack corner diagonal state from packed uint.
// corner: 0=TL, 1=TR, 2=BR, 3=BL
uint get_diag(uint packed, uint corner) {
    return (packed >> (corner * 2u)) & 3u;
}

// Build Voronoi cell vertices for source pixel (px, py).
// Returns vertex count; fills verts[0..count].
// Offsets are in source-space relative to (px, py).
int build_cell(uint px, uint py, out vec2 verts[8]) {
    uint packed = diag_states[py * src_w + px];
    uint tl = get_diag(packed, 0u);
    uint tr = get_diag(packed, 1u);
    uint br = get_diag(packed, 2u);
    uint bl = get_diag(packed, 3u);

    float bx = float(px);
    float by = float(py);
    int n = 0;

    // TL corner (rel=BR)
    if (tl == 1u) {
        verts[n++] = vec2(bx - 0.25, by + 0.25);
        verts[n++] = vec2(bx + 0.25, by - 0.25);
    } else if (tl == 2u) {
        verts[n++] = vec2(bx + 0.25, by + 0.25);
    } else {
        verts[n++] = vec2(bx, by);
    }

    // TR corner (rel=BL)
    if (tr == 1u) {
        verts[n++] = vec2(bx + 0.75, by + 0.25);
    } else if (tr == 2u) {
        verts[n++] = vec2(bx + 0.75, by - 0.25);
        verts[n++] = vec2(bx + 1.25, by + 0.25);
    } else {
        verts[n++] = vec2(bx + 1.0, by);
    }

    // BR corner (rel=TL)
    if (br == 1u) {
        verts[n++] = vec2(bx + 1.25, by + 0.75);
        verts[n++] = vec2(bx + 0.75, by + 1.25);
    } else if (br == 2u) {
        verts[n++] = vec2(bx + 0.75, by + 0.75);
    } else {
        verts[n++] = vec2(bx + 1.0, by + 1.0);
    }

    // BL corner (rel=TR)
    if (bl == 1u) {
        verts[n++] = vec2(bx + 0.25, by + 0.75);
    } else if (bl == 2u) {
        verts[n++] = vec2(bx + 0.25, by + 1.25);
        verts[n++] = vec2(bx - 0.25, by + 0.75);
    } else {
        verts[n++] = vec2(bx, by + 1.0);
    }

    return n;
}

// Point-in-convex-polygon via cross-product winding test.
bool point_in_cell(vec2 verts[8], int nv, vec2 p) {
    int sign = 0;
    for (int i = 0; i < nv; i++) {
        vec2 v0 = verts[i];
        vec2 v1 = verts[(i + 1) % nv];
        float cross = (v1.x - v0.x) * (p.y - v0.y) - (v1.y - v0.y) * (p.x - v0.x);
        int s = (cross > 1e-6) ? 1 : ((cross < -1e-6) ? -1 : 0);
        if (s != 0) {
            if (sign == 0) sign = s;
            else if (sign != s) return false;
        }
    }
    return true;
}

// Find which source pixel owns this point via Voronoi cell test.
uint find_owner(vec2 sp) {
    uint home_x = min(uint(sp.x), src_w - 1u);
    uint home_y = min(uint(sp.y), src_h - 1u);
    uint home_id = home_y * src_w + home_x;

    // Fast path: no diagonals at any corner → cell is a perfect square
    uint packed = diag_states[home_id];
    if (packed == 0u) return home_id;

    // Check home cell
    vec2 verts[8];
    int nv = build_cell(home_x, home_y, verts);
    if (point_in_cell(verts, nv, sp)) return home_id;

    // Check 8 neighbors
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            if (dx == 0 && dy == 0) continue;
            int nx = int(home_x) + dx;
            int ny = int(home_y) + dy;
            if (nx < 0 || ny < 0 || nx >= int(src_w) || ny >= int(src_h)) continue;
            nv = build_cell(uint(nx), uint(ny), verts);
            if (point_in_cell(verts, nv, sp)) return uint(ny) * src_w + uint(nx);
        }
    }

    return home_id; // fallback
}

void main() {
    uint ox = gl_GlobalInvocationID.x;
    uint oy = gl_GlobalInvocationID.y;
    if (ox >= out_w || oy >= out_h) return;

    // Output pixel center in source coordinates
    float sx = (float(ox) + 0.5) * inv_scale;
    float sy = (float(oy) + 0.5) * inv_scale;

    // Find owner via Voronoi cell geometry
    uint owner = find_owner(vec2(sx, sy));
    uint my_region = src_regions[owner];

    // Search window in source pixels
    float r_sq = radius * radius;
    int min_px = max(int(floor(sx - radius)), 0);
    int max_px = min(int(ceil(sx + radius)), int(src_w) - 1);
    int min_py = max(int(floor(sy - radius)), 0);
    int max_py = min(int(ceil(sy + radius)), int(src_h) - 1);

    // Gaussian-weighted color accumulation
    float tr = 0.0, tg = 0.0, tb = 0.0, tw = 0.0;

    for (int py = min_py; py <= max_py; py++) {
        for (int px = min_px; px <= max_px; px++) {
            uint idx = uint(py) * src_w + uint(px);
            if (src_regions[idx] != my_region) continue;

            float dx = sx - (float(px) + 0.5);
            float dy = sy - (float(py) + 0.5);
            float d_sq = dx * dx + dy * dy;
            if (d_sq > r_sq) continue;

            float w = exp(-d_sq * gauss_k);
            uint color = src_pixels[idx];
            tr += w * float((color >> 16u) & 0xFFu);
            tg += w * float((color >> 8u) & 0xFFu);
            tb += w * float(color & 0xFFu);
            tw += w;
        }
    }

    vec4 rgba;
    if (tw > 0.0) {
        float inv_tw = 1.0 / tw;
        rgba = vec4(
            clamp(tr * inv_tw / 255.0, 0.0, 1.0),
            clamp(tg * inv_tw / 255.0, 0.0, 1.0),
            clamp(tb * inv_tw / 255.0, 0.0, 1.0),
            1.0
        );
    } else {
        rgba = vec4(0.0, 0.0, 0.0, 1.0);
    }

    imageStore(output_img, ivec2(ox, oy), rgba);
}
