#version 450

// xBR — pixel-art scaling (2x, 3x, 4x) by Hyllian.
// Compute shader variant with resolved CP lookups for naga WGSL compatibility.

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, set = 0, binding = 0) readonly buffer PixelBuf { uint pixels[]; };
layout(set = 1, binding = 0, rgba8) writeonly uniform image2D output_img;
layout(std140, set = 2, binding = 0) uniform Uniforms {
    uint src_w;
    uint src_h;
    uint out_w;
    uint out_h;
    uint iscale;
    uint _pad0;
    uint _pad1;
    uint _pad2;
};

vec4 unpack(uint c) {
    return vec4(float((c >> 16u) & 0xFFu) / 255.0,
                float((c >> 8u) & 0xFFu) / 255.0,
                float(c & 0xFFu) / 255.0, 1.0);
}

vec4 fetch(ivec2 coord) {
    coord = clamp(coord, ivec2(0), ivec2(int(src_w) - 1, int(src_h) - 1));
    return unpack(pixels[coord.y * int(src_w) + coord.x]);
}

float color_dist(vec4 a, vec4 b) {
    vec3 d = (a.rgb - b.rgb) * 255.0;
    float dy  =  0.299 * d.r + 0.587 * d.g + 0.114 * d.b;
    float dcb = -0.169 * d.r - 0.331 * d.g + 0.500 * d.b;
    float dcr =  0.500 * d.r - 0.419 * d.g - 0.081 * d.b;
    return 48.0 * dy * dy + 7.0 * dcb * dcb + 6.0 * dcr * dcr;
}

vec4 blend(vec4 a, vec4 b, float alpha) {
    return mix(a, b, clamp(alpha, 0.0, 1.0));
}

const float B32  = 32.0 / 256.0;
const float B64  = 64.0 / 256.0;
const float B128 = 128.0 / 256.0;
const float B192 = 192.0 / 256.0;
const float B224 = 224.0 / 256.0;

// Resolved corner pixels: F, H, I, C, G, B, D, F4, H5, I4, I5
// Set before calling any filter function.
vec4 cF, cH, cI, cC, cG, cB, cD, cF4, cH5, cI4, cI5;
vec4 cE; // center pixel (nb[12])

void resolve_cp(vec4 nb[25], int cp[11]) {
    cF = nb[cp[0]]; cH = nb[cp[1]]; cI = nb[cp[2]];
    cC = nb[cp[3]]; cG = nb[cp[4]]; cB = nb[cp[5]];
    cD = nb[cp[6]]; cF4 = nb[cp[7]]; cH5 = nb[cp[8]];
    cI4 = nb[cp[9]]; cI5 = nb[cp[10]];
    cE = nb[12];
}

vec2 edge_weights() {
    float ew = color_dist(cE, cC) + color_dist(cE, cG)
        + color_dist(cI, cH5) + color_dist(cI, cF4)
        + 4.0 * color_dist(cH, cF);
    float iw = color_dist(cH, cD) + color_dist(cH, cI5)
        + color_dist(cF, cI4) + color_dist(cF, cB)
        + 4.0 * color_dist(cE, cI);
    return vec2(ew, iw);
}

vec4 pick_color() {
    return color_dist(cE, cF) <= color_dist(cE, cH) ? cF : cH;
}

void detect_direction(out bool is_left, out bool is_up) {
    float ke = color_dist(cF, cG);
    float ki = color_dist(cH, cC);
    is_left = ke * 2.0 <= ki && cE != cG && cD != cG;
    is_up   = ke >= ki * 2.0 && cE != cC && cB != cC;
}

bool sub_cond_24() {
    return (cF != cB && cH != cD)
        || (cE == cI && cF != cI4 && cH != cI5)
        || cE == cG
        || cE == cC;
}

bool sub_cond_3() {
    return (cF != cB && cF != cC)
        || (cH != cD && cH != cG)
        || (cE == cI
            && ((cF != cF4 && cF != cI4)
                || (cH != cH5 && cH != cI5)))
        || cE == cG
        || cE == cC;
}

vec4 filt2x(vec4 e) {
    if (cE == cH || cE == cF) return e;
    vec2 ew_iw = edge_weights();
    if (ew_iw.x > ew_iw.y) return e;
    vec4 px = pick_color();
    if (ew_iw.x < ew_iw.y && sub_cond_24()) {
        bool left, up;
        detect_direction(left, up);
        if (left && up) return blend(e, px, B224);
        if (left)       return blend(e, px, B192);
        if (up)         return blend(e, px, B192);
        return blend(e, px, B128);
    }
    return blend(e, px, B128);
}

void filt3x(vec4 e, inout vec4 corner, inout vec4 side_h, inout vec4 side_f) {
    if (cE == cH || cE == cF) return;
    vec2 ew_iw = edge_weights();
    if (ew_iw.x > ew_iw.y) return;
    vec4 px = pick_color();
    if (ew_iw.x < ew_iw.y && sub_cond_3()) {
        bool left, up;
        detect_direction(left, up);
        if (left && up) {
            vec4 bh = blend(side_h, px, B192);
            side_h = bh; side_f = bh;
            corner = px;
        } else if (left) {
            side_h = blend(side_h, px, B192);
            side_f = blend(side_f, px, B64);
            corner = px;
        } else if (up) {
            side_f = blend(side_f, px, B192);
            side_h = blend(side_h, px, B64);
            corner = px;
        } else {
            corner = blend(corner, px, B224);
            side_f = blend(side_f, px, B32);
            side_h = blend(side_h, px, B32);
        }
    } else {
        corner = blend(corner, px, B128);
    }
}

vec4 g_out_block[16];

void filt4x(vec4 e, int n15, int n14, int n13, int n12,
            int n11, int n10, int n7, int n3) {
    if (cE == cH || cE == cF) return;
    vec2 ew_iw = edge_weights();
    if (ew_iw.x > ew_iw.y) return;
    vec4 px = pick_color();
    if (ew_iw.x < ew_iw.y && sub_cond_24()) {
        bool left, up;
        detect_direction(left, up);
        if (left && up) {
            vec4 b13 = blend(g_out_block[n13], px, B192);
            vec4 b12 = blend(g_out_block[n12], px, B64);
            g_out_block[n13] = b13; g_out_block[n12] = b12;
            g_out_block[n15] = px; g_out_block[n14] = px;
            g_out_block[n11] = px; g_out_block[n10] = b12;
            g_out_block[n3] = b12; g_out_block[n7] = b13;
        } else if (left) {
            g_out_block[n11] = blend(g_out_block[n11], px, B192);
            g_out_block[n13] = blend(g_out_block[n13], px, B192);
            g_out_block[n10] = blend(g_out_block[n10], px, B64);
            g_out_block[n12] = blend(g_out_block[n12], px, B64);
            g_out_block[n14] = px; g_out_block[n15] = px;
        } else if (up) {
            g_out_block[n14] = blend(g_out_block[n14], px, B192);
            g_out_block[n7]  = blend(g_out_block[n7],  px, B192);
            g_out_block[n10] = blend(g_out_block[n10], px, B64);
            g_out_block[n3]  = blend(g_out_block[n3],  px, B64);
            g_out_block[n11] = px; g_out_block[n15] = px;
        } else {
            g_out_block[n11] = blend(g_out_block[n11], px, B128);
            g_out_block[n14] = blend(g_out_block[n14], px, B128);
            g_out_block[n15] = px;
        }
    } else {
        g_out_block[n15] = blend(g_out_block[n15], px, B128);
    }
}

// Corner parameter indices: F, H, I, C, G, B, D, F4, H5, I4, I5
const int CP_BR[11] = int[](13,17,18, 8,16, 7,11, 14,22, 19,23);
const int CP_BL[11] = int[](11,17,16, 6,18, 7,13, 10,22, 15,21);
const int CP_TR[11] = int[](13, 7, 8, 18, 6, 17,11, 14, 2,  9, 3);
const int CP_TL[11] = int[](11, 7, 6, 16, 8, 17,13, 10, 2,  5, 1);

void main() {
    ivec2 out_pos = ivec2(gl_GlobalInvocationID.xy);
    if (out_pos.x >= int(out_w) || out_pos.y >= int(out_h)) return;

    int isc = int(iscale);
    ivec2 src_i = out_pos / isc;
    ivec2 sub = out_pos - src_i * isc;
    src_i = clamp(src_i, ivec2(0), ivec2(int(src_w) - 1, int(src_h) - 1));

    // Sample 5x5 neighborhood into local array
    vec4 nb[25];
    for (int j = 0; j < 5; j++)
        for (int i = 0; i < 5; i++)
            nb[j * 5 + i] = fetch(src_i + ivec2(i - 2, j - 2));

    vec4 e = nb[12];

    if (isc == 2) {
        int cp[11];
        if (sub.x == 0 && sub.y == 0) cp = CP_TL;
        else if (sub.x == 1 && sub.y == 0) cp = CP_TR;
        else if (sub.x == 0 && sub.y == 1) cp = CP_BL;
        else cp = CP_BR;
        resolve_cp(nb, cp);
        imageStore(output_img, out_pos, filt2x(e));

    } else if (isc == 3) {
        if (sub.x == 1 && sub.y == 1) {
            imageStore(output_img, out_pos, e);
        } else {
            int cx = sub.x < 1 ? 0 : (sub.x > 1 ? 1 : 0);
            int cy = sub.y < 1 ? 0 : (sub.y > 1 ? 1 : 0);
            int cp[11];
            if (cx == 0 && cy == 0) cp = CP_TL;
            else if (cx == 1 && cy == 0) cp = CP_TR;
            else if (cx == 0 && cy == 1) cp = CP_BL;
            else cp = CP_BR;
            resolve_cp(nb, cp);

            vec4 corner = e, side_h = e, side_f = e;
            filt3x(e, corner, side_h, side_f);

            if (sub.x != 1 && sub.y != 1) imageStore(output_img, out_pos, corner);
            else if (sub.x == 1) imageStore(output_img, out_pos, side_h);
            else imageStore(output_img, out_pos, side_f);
        }

    } else {
        for (int i = 0; i < 16; i++) g_out_block[i] = e;

        resolve_cp(nb, CP_BR);
        filt4x(e, 15,14,13,12, 11,10, 7, 3);
        resolve_cp(nb, CP_BL);
        filt4x(e, 12,13,14,15,  8, 9, 4, 0);
        resolve_cp(nb, CP_TR);
        filt4x(e,  3, 2, 1, 0,  7, 6,11,15);
        resolve_cp(nb, CP_TL);
        filt4x(e,  0, 1, 2, 3,  4, 5, 8,12);

        imageStore(output_img, out_pos, g_out_block[sub.y * 4 + sub.x]);
    }
}
