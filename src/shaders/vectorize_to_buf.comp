#version 450

// Scanline rasterizer variant that writes flat colors to a storage buffer.
// Used as pass 1 of the spline-diffusion pipeline.
//
// NO anti-aliasing: single center-point sample per pixel, producing hard
// region boundaries. The diffusion pass does its own 2x2 supersampling
// for smooth output; blended intermediate colors here would break region
// matching.

layout(local_size_x = 16, local_size_y = 16) in;

// SDL3 SPIRV compute: set 0 = readonly storage buffers
layout(std430, set = 0, binding = 0) readonly buffer EdgeBuf {
    float edge_data[];
};

layout(std430, set = 0, binding = 1) readonly buffer RowRangeBuf {
    uint row_data[];
};

layout(std430, set = 0, binding = 2) readonly buffer EdgeIndexBuf {
    uint edge_indices[];
};

// SDL3 SPIRV compute: set 1 = readwrite storage buffers
layout(std430, set = 1, binding = 0) buffer OutputBuf {
    uint out_colors[];
};

// SDL3 SPIRV compute: set 2 = uniform buffers
layout(std140, set = 2, binding = 0) uniform Uniforms {
    uint out_w;
    uint out_h;
    uint num_edges;
    uint bg_color;
};

float edge_x0(uint i)       { return edge_data[i * 8u + 0u]; }
float edge_y0(uint i)       { return edge_data[i * 8u + 1u]; }
float edge_dx_per_dy(uint i){ return edge_data[i * 8u + 2u]; }
float edge_y_min(uint i)    { return edge_data[i * 8u + 3u]; }
float edge_y_max(uint i)    { return edge_data[i * 8u + 4u]; }
int   edge_dir(uint i)      { return floatBitsToInt(edge_data[i * 8u + 5u]); }
uint  edge_color(uint i)    { return floatBitsToUint(edge_data[i * 8u + 6u]); }

uint row_start(uint r) { return row_data[r * 2u]; }
uint row_count(uint r) { return row_data[r * 2u + 1u]; }

void main() {
    uint px = gl_GlobalInvocationID.x;
    uint py = gl_GlobalInvocationID.y;
    if (px >= out_w || py >= out_h) return;

    uint color = bg_color;

    // Single center-point sample: no AA blending, hard region boundaries
    float sx = float(px) + 0.5;
    float sy = float(py) + 0.5;

    uint r_start = row_start(py);
    uint r_count = row_count(py);

    uint prev_color = 0x01000000u;
    int winding = 0;

    for (uint ri = 0u; ri < r_count; ri++) {
        uint ei = edge_indices[r_start + ri];

        float e_x0 = edge_x0(ei);
        float e_y0 = edge_y0(ei);
        float e_dx = edge_dx_per_dy(ei);
        float e_ymin = edge_y_min(ei);
        float e_ymax = edge_y_max(ei);
        int e_dir = edge_dir(ei);
        uint e_color = edge_color(ei);

        // New path: apply previous path's winding
        if (e_color != prev_color && prev_color != 0x01000000u) {
            if (winding != 0) {
                color = prev_color;
            }
            winding = 0;
        }
        prev_color = e_color;

        if (sy >= e_ymin && sy < e_ymax) {
            float ix = e_x0 + (sy - e_y0) * e_dx;
            if (sx < ix) winding += e_dir;
        }
    }

    // Final path
    if (prev_color != 0x01000000u && winding != 0) {
        color = prev_color;
    }

    out_colors[py * out_w + px] = color;
}
