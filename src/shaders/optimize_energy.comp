#version 450

// Golden section search optimizer for B-spline control points.
// Matches the reference GPU implementation (OptimizeEnergy.vert).
//
// Energy function: E = E_curvature + E_positional
//   E_curvature = |p0 - 2*p1 + p2|²  (simple κ² approximation)
//   E_positional = (2.5 * distance(p, p_orig))⁴
//
// Search direction: gradient of curvature energy only (8*p1 - 4*p0 - 4*p2).
// The golden section search minimizes total energy along this direction.
//
// Flag encoding:
//   bit 0 (1u)  = pinned (junction/border — don't move)
//   bit 4 (16u) = IS_CORNER (sharp turn detected by checkForCorner)
//   bit 5 (32u) = IS_TJUNCTION (T-junction — will be corrected post-optimization)
//
// Spans containing any corner node skip optimization entirely, matching
// the reference implementation.

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) readonly buffer PositionsIn {
    float pos_in[];
};

layout(std430, set = 0, binding = 1) readonly buffer OrigPositions {
    float orig_pos[];
};

layout(std430, set = 0, binding = 2) readonly buffer Neighbors {
    int neighbor_data[];
};

layout(std430, set = 0, binding = 3) readonly buffer Flags {
    uint node_flags[];
};

layout(std430, set = 1, binding = 0) writeonly buffer PositionsOut {
    float pos_out[];
};

layout(std140, set = 2, binding = 0) uniform Uniforms {
    uint num_nodes;
    float gradient_step;  // unused (kept for ABI compatibility)
    float max_move;       // unused (golden section uses its own bracket)
    float positional_scale; // 2.5
};

const uint IS_CORNER = 16u;
const uint IS_TJUNCTION = 32u;

vec2 read_pos(uint i) {
    return vec2(pos_in[i * 2u], pos_in[i * 2u + 1u]);
}

// Read neighbor position, using corrected position for T-junctions.
// When a neighbor is a T-junction, its corrected position is stored at slot+1
// (matching reference HAS_CORRECTED_POSITION behavior).
vec2 read_neighbor_pos(uint i) {
    if ((node_flags[i] & IS_TJUNCTION) != 0u) {
        uint ci = i + 1u; // corrected position at next slot
        vec2 p = vec2(pos_in[ci * 2u], pos_in[ci * 2u + 1u]);
        // Only use if corrected position was written (non-zero)
        if (p.x != 0.0 || p.y != 0.0) return p;
    }
    return vec2(pos_in[i * 2u], pos_in[i * 2u + 1u]);
}

vec2 read_orig(uint i) {
    return vec2(orig_pos[i * 2u], orig_pos[i * 2u + 1u]);
}

// Simple curvature energy: |p0 - 2*p1 + p2|²
float calc_curvature_energy(vec2 n0, vec2 p, vec2 n1) {
    vec2 tmp = n0 - 2.0 * p + n1;
    return tmp.x * tmp.x + tmp.y * tmp.y;
}

// Positional energy: (2.5 * distance)^4
float calc_positional_energy(vec2 p_new, vec2 p_old) {
    float dist = positional_scale * distance(p_new, p_old);
    return dist * dist * dist * dist;
}

// Total energy at a given position
float total_energy(vec2 n0, vec2 p, vec2 n1, vec2 p_orig) {
    return calc_curvature_energy(n0, p, n1) + calc_positional_energy(p, p_orig);
}

// Curvature gradient: d/dp |n0 - 2p + n1|² = 8p - 4n0 - 4n1
vec2 calc_gradient(vec2 n0, vec2 p, vec2 n1) {
    return 8.0 * p - 4.0 * n0 - 4.0 * n1;
}

// Golden section search constants (matching reference)
const float GS_R = 0.61803399;
const float GS_C = 0.38196601; // 1 - R
const float GS_TOL = 0.0001;
const int GS_MAX_ITER = 20;
const float BRACKET_A = 0.1;
const float BRACKET_B = -0.1;
const float GOLD = 1.618034;
const float GLIMIT = 10.0;
const float TINY = 0.000000001;

// Find bracket around minimum via parabolic interpolation
vec3 find_bracket(vec2 n0, vec2 n1, vec2 p, vec2 p_orig, vec2 gradient) {
    float ax = BRACKET_A;
    float bx = BRACKET_B;
    float fa = total_energy(n0, p - gradient * ax, n1, p_orig);
    float fb = total_energy(n0, p - gradient * bx, n1, p_orig);

    // Ensure fa >= fb (go downhill from a to b)
    if (fb > fa) {
        float tmp;
        tmp = ax; ax = bx; bx = tmp;
        tmp = fa; fa = fb; fb = tmp;
    }

    float cx = bx + GOLD * (bx - ax);
    float fc = total_energy(n0, p - gradient * cx, n1, p_orig);

    int guard = 0;
    while (fb > fc && guard < 100) {
        guard++;
        float r = (bx - ax) * (fb - fc);
        float q = (bx - cx) * (fb - fa);
        float qr = q - r;
        float u = bx - ((bx - cx) * q - (bx - ax) * r) / (2.0 * sign(qr) * max(abs(qr), TINY));
        float ulim = bx + GLIMIT * (cx - bx);
        float fu;

        if ((bx - u) * (u - cx) > 0.0) {
            fu = total_energy(n0, p - gradient * u, n1, p_orig);
            if (fu < fc) return vec3(bx, u, cx);
            if (fu > fb) return vec3(ax, bx, u);
            u = cx + GOLD * (cx - bx);
            fu = total_energy(n0, p - gradient * u, n1, p_orig);
        } else if ((cx - u) * (u - ulim) > 0.0) {
            fu = total_energy(n0, p - gradient * u, n1, p_orig);
            if (fu < fc) {
                float dum = cx + GOLD * (cx - bx);
                bx = cx; cx = u; u = dum;
                fb = fc; fc = fu;
                fu = total_energy(n0, p - gradient * u, n1, p_orig);
            }
        } else if ((u - ulim) * (ulim - cx) >= 0.0) {
            u = ulim;
            fu = total_energy(n0, p - gradient * u, n1, p_orig);
        } else {
            u = cx + GOLD * (cx - bx);
            fu = total_energy(n0, p - gradient * u, n1, p_orig);
        }

        ax = bx; bx = cx; cx = u;
        fa = fb; fb = fc; fc = fu;
    }
    return vec3(ax, bx, cx);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= num_nodes) return;

    vec2 p = read_pos(i);
    pos_out[i * 2u] = p.x;
    pos_out[i * 2u + 1u] = p.y;

    uint flags = node_flags[i];

    // Pinned nodes don't move
    if ((flags & 1u) != 0u) return;

    // Touch all buffers to prevent spirv-cross from dropping them
    int _dummy_nbr = neighbor_data[0];
    float _dummy_orig = orig_pos[0];

    int prev_idx = neighbor_data[i * 4u];
    int next_idx = neighbor_data[i * 4u + 1u];
    if (prev_idx < 0 || next_idx < 0) return;

    // Skip optimization entirely for spans containing corner nodes
    // (matches reference: DONT_OPTIMIZE flags prevent optimization)
    if ((flags & IS_CORNER) != 0u) return;
    if ((node_flags[uint(prev_idx)] & IS_CORNER) != 0u) return;
    if ((node_flags[uint(next_idx)] & IS_CORNER) != 0u) return;

    vec2 n0 = read_neighbor_pos(uint(prev_idx));
    vec2 n1 = read_neighbor_pos(uint(next_idx));
    vec2 p_orig = read_orig(i);

    // Compute curvature gradient direction
    vec2 gradient = calc_gradient(n0, p, n1);
    float grad_len = length(gradient);
    if (grad_len < 1e-12) return;
    gradient = gradient / grad_len; // normalize

    // Golden section search along gradient direction
    vec3 bracket = find_bracket(n0, n1, p, p_orig, gradient);

    float x0 = bracket.x;
    float x3 = bracket.z;
    float x1, x2;

    if (abs(bracket.z - bracket.y) > abs(bracket.y - bracket.x)) {
        x1 = bracket.y;
        x2 = bracket.y + GS_C * (bracket.z - bracket.y);
    } else {
        x1 = bracket.y - GS_C * (bracket.y - bracket.x);
        x2 = bracket.y;
    }

    float f1 = total_energy(n0, p - gradient * x1, n1, p_orig);
    float f2 = total_energy(n0, p - gradient * x2, n1, p_orig);

    for (int iter = 0; iter < GS_MAX_ITER; iter++) {
        if (abs(x3 - x0) <= GS_TOL * (abs(x1) + abs(x2))) break;

        if (f2 < f1) {
            x0 = x1;
            x1 = x2;
            x2 = GS_R * x1 + GS_C * x3;
            f1 = f2;
            f2 = total_energy(n0, p - gradient * x2, n1, p_orig);
        } else {
            x3 = x2;
            x2 = x1;
            x1 = GS_R * x2 + GS_C * x0;
            f2 = f1;
            f1 = total_energy(n0, p - gradient * x1, n1, p_orig);
        }
    }

    float offset = (f1 < f2) ? x1 : x2;
    vec2 optimized = p - gradient * offset;

    pos_out[i * 2u] = optimized.x;
    pos_out[i * 2u + 1u] = optimized.y;
}
