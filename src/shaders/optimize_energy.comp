#version 450

// 2D Newton-Raphson optimizer for B-spline control points.
//
// Energy function: E = E_curvature + E_positional
//   E_curvature = |p0 - 2*p1 + p2|²  (simple κ² approximation)
//   E_positional = (2.5 * distance(p, p_orig))⁴
//
// Both gradient and Hessian are analytical, so Newton converges in 2-3
// iterations vs the ~120 energy evaluations the old golden section search
// needed.
//
// Flag encoding:
//   bit 0 (1u)  = pinned (junction/border — don't move)
//   bit 4 (16u) = IS_CORNER (sharp turn detected by checkForCorner)
//   bit 5 (32u) = IS_TJUNCTION (T-junction — will be corrected post-optimization)
//
// Spans containing any corner node skip optimization entirely, matching
// the reference implementation.

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) readonly buffer PositionsIn {
    float pos_in[];
};

layout(std430, set = 0, binding = 1) readonly buffer OrigPositions {
    float orig_pos[];
};

layout(std430, set = 0, binding = 2) readonly buffer Neighbors {
    int neighbor_data[];
};

layout(std430, set = 0, binding = 3) readonly buffer Flags {
    uint node_flags[];
};

layout(std430, set = 1, binding = 0) buffer PositionsOut {
    float pos_out[];
};

layout(std140, set = 2, binding = 0) uniform Uniforms {
    uint num_nodes;
    float gradient_step;  // unused (kept for ABI compatibility)
    float max_move;       // unused
    float positional_scale; // 2.5
};

const uint IS_CORNER = 16u;
const uint IS_TJUNCTION = 32u;
const int NEWTON_ITER = 3;

vec2 read_pos(uint i) {
    return vec2(pos_in[i * 2u], pos_in[i * 2u + 1u]);
}

// Read neighbor position, using corrected position for T-junctions.
// When a neighbor is a T-junction, its corrected position is stored at slot+1
// (matching reference HAS_CORRECTED_POSITION behavior).
vec2 read_neighbor_pos(uint i) {
    if ((node_flags[i] & IS_TJUNCTION) != 0u) {
        uint ci = i + 1u; // corrected position at next slot
        vec2 p = vec2(pos_in[ci * 2u], pos_in[ci * 2u + 1u]);
        // Only use if corrected position was written (non-zero).
        // Safe: (0,0) is never a valid CP position for GB images
        // since all grid corners are at positive integer coordinates.
        if (p.x != 0.0 || p.y != 0.0) return p;
    }
    return vec2(pos_in[i * 2u], pos_in[i * 2u + 1u]);
}

vec2 read_orig(uint i) {
    return vec2(orig_pos[i * 2u], orig_pos[i * 2u + 1u]);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= num_nodes) return;

    vec2 p = read_pos(i);
    pos_out[i * 2u] = p.x;
    pos_out[i * 2u + 1u] = p.y;

    uint flags = node_flags[i];

    // Pinned nodes don't move
    if ((flags & 1u) != 0u) return;

    // Touch all buffers to prevent spirv-cross from dropping them
    int _dummy_nbr = neighbor_data[0];
    float _dummy_orig = orig_pos[0];

    int prev_idx = neighbor_data[i * 4u];
    int next_idx = neighbor_data[i * 4u + 1u];
    if (prev_idx < 0 || next_idx < 0) return;

    // Skip optimization entirely for spans containing corner nodes
    // (matches reference: DONT_OPTIMIZE flags prevent optimization)
    if ((flags & IS_CORNER) != 0u) return;
    if ((node_flags[uint(prev_idx)] & IS_CORNER) != 0u) return;
    if ((node_flags[uint(next_idx)] & IS_CORNER) != 0u) return;

    vec2 n0 = read_neighbor_pos(uint(prev_idx));
    vec2 n1 = read_neighbor_pos(uint(next_idx));
    vec2 p_orig = read_orig(i);

    // 2D Newton-Raphson: minimize E = |n0-2p+n1|² + (2.5·||p-p_orig||)⁴
    // Gradient: ∇E = 4(2p-n0-n1) + 4·s⁴·||d||²·d
    // Hessian:   H = 8I + 4·s⁴·(2d⊗d + ||d||²·I)
    float s4 = positional_scale * positional_scale;
    s4 *= s4; // 2.5⁴ = 39.0625

    for (int iter = 0; iter < NEWTON_ITER; iter++) {
        vec2 d = p - p_orig;
        float d2 = dot(d, d);

        vec2 grad = 4.0 * (2.0 * p - n0 - n1) + 4.0 * s4 * d2 * d;

        float h00 = 8.0 + 4.0 * s4 * (2.0 * d.x * d.x + d2);
        float h11 = 8.0 + 4.0 * s4 * (2.0 * d.y * d.y + d2);
        float h01 = 8.0 * s4 * d.x * d.y;

        float det = h00 * h11 - h01 * h01;
        if (abs(det) < 1e-20) break;

        p -= vec2(h11 * grad.x - h01 * grad.y,
                  -h01 * grad.x + h00 * grad.y) / det;
    }

    pos_out[i * 2u] = p.x;
    pos_out[i * 2u + 1u] = p.y;
}
