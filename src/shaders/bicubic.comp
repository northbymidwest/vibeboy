#version 450

// Bicubic (Catmull-Rom) interpolation compute shader.

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, set = 0, binding = 0) readonly buffer PixelBuf {
    uint pixels[];
};

layout(set = 1, binding = 0, rgba8) writeonly uniform image2D output_img;

layout(std140, set = 2, binding = 0) uniform Uniforms {
    uint src_w;
    uint src_h;
    uint out_w;
    uint out_h;
};

vec4 unpack(uint c) {
    return vec4(
        float((c >> 16u) & 0xFFu) / 255.0,
        float((c >> 8u)  & 0xFFu) / 255.0,
        float( c         & 0xFFu) / 255.0,
        1.0
    );
}

vec3 fetch_rgb(ivec2 coord) {
    coord = clamp(coord, ivec2(0), ivec2(int(src_w) - 1, int(src_h) - 1));
    return unpack(pixels[coord.y * int(src_w) + coord.x]).rgb;
}

vec4 cubic_weight(float t) {
    float t2 = t * t;
    float t3 = t2 * t;
    return vec4(
        -0.5 * t3 + t2 - 0.5 * t,
         1.5 * t3 - 2.5 * t2 + 1.0,
        -1.5 * t3 + 2.0 * t2 + 0.5 * t,
         0.5 * t3 - 0.5 * t2
    );
}

void main() {
    uint opx = gl_GlobalInvocationID.x;
    uint opy = gl_GlobalInvocationID.y;
    if (opx >= out_w || opy >= out_h) return;

    vec2 src_coord = (vec2(opx, opy) + 0.5) * vec2(float(src_w) / float(out_w), float(src_h) / float(out_h)) - 0.5;
    ivec2 src_i = ivec2(floor(src_coord));
    vec2 f = src_coord - vec2(src_i);

    vec4 wx = cubic_weight(f.x);
    vec4 wy = cubic_weight(f.y);

    vec3 color = vec3(0.0);
    for (int j = 0; j < 4; j++) {
        for (int i = 0; i < 4; i++) {
            float w = wx[i] * wy[j];
            color += fetch_rgb(src_i + ivec2(i - 1, j - 1)) * w;
        }
    }

    imageStore(output_img, ivec2(opx, opy), vec4(clamp(color, 0.0, 1.0), 1.0));
}
