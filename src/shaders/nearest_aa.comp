#version 450

// Antialiased nearest-neighbor scaling compute shader.

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, set = 0, binding = 0) readonly buffer PixelBuf {
    uint pixels[];
};

layout(set = 1, binding = 0, rgba8) writeonly uniform image2D output_img;

layout(std140, set = 2, binding = 0) uniform Uniforms {
    uint src_w;
    uint src_h;
    uint out_w;
    uint out_h;
};

vec3 fetch_rgb(ivec2 coord) {
    coord = clamp(coord, ivec2(0), ivec2(int(src_w) - 1, int(src_h) - 1));
    uint c = pixels[coord.y * int(src_w) + coord.x];
    return vec3(
        float((c >> 16u) & 0xFFu) / 255.0,
        float((c >> 8u)  & 0xFFu) / 255.0,
        float( c         & 0xFFu) / 255.0
    );
}

void main() {
    uint opx = gl_GlobalInvocationID.x;
    uint opy = gl_GlobalInvocationID.y;
    if (opx >= out_w || opy >= out_h) return;

    vec2 pixel = vec2(float(src_w), float(src_h)) / vec2(float(out_w), float(out_h));
    vec2 uv = (vec2(opx, opy) + 0.5) / vec2(float(out_w), float(out_h));
    vec2 src0 = uv * vec2(float(src_w), float(src_h)) - pixel * 0.5;
    vec2 src1 = src0 + pixel;

    vec2 src_max = vec2(float(src_w) - 1.0, float(src_h) - 1.0);
    ivec2 i0 = ivec2(clamp(floor(src0), vec2(0.0), src_max));
    ivec2 i1 = ivec2(clamp(floor(src1 - vec2(1e-5)), vec2(0.0), src_max));

    if (i0 == i1) {
        imageStore(output_img, ivec2(opx, opy), vec4(fetch_rgb(i0), 1.0));
    } else {
        vec3 acc = vec3(0.0);
        float area_total = 0.0;

        for (int iy = i0.y; iy <= i1.y; iy++) {
            float top = max(float(iy), src0.y);
            float bot = min(float(iy + 1), src1.y);
            float h = bot - top;
            if (h <= 0.0) continue;

            for (int ix = i0.x; ix <= i1.x; ix++) {
                float left = max(float(ix), src0.x);
                float right = min(float(ix + 1), src1.x);
                float w = right - left;
                if (w <= 0.0) continue;

                float area = w * h;
                acc += fetch_rgb(ivec2(ix, iy)) * area;
                area_total += area;
            }
        }

        imageStore(output_img, ivec2(opx, opy), vec4(acc / max(area_total, 1e-5), 1.0));
    }
}
