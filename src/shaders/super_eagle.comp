#version 450

// Super Eagle compute shader by Kreed — diagonal-aware 2x scaling.

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, set = 0, binding = 0) readonly buffer PixelBuf {
    uint pixels[];
};

layout(set = 1, binding = 0, rgba8) writeonly uniform image2D output_img;

layout(std140, set = 2, binding = 0) uniform Uniforms {
    uint src_w;
    uint src_h;
    uint out_w;
    uint out_h;
    uint _pad0;
    uint _pad1;
    uint _pad2;
    uint _pad3;
};

vec4 unpack(uint c) {
    return vec4(
        float((c >> 16u) & 0xFFu) / 255.0,
        float((c >>  8u) & 0xFFu) / 255.0,
        float( c         & 0xFFu) / 255.0,
        1.0
    );
}

uint fetch(ivec2 coord) {
    coord = clamp(coord, ivec2(0), ivec2(int(src_w) - 1, int(src_h) - 1));
    return pixels[coord.y * int(src_w) + coord.x];
}

uint interp(uint a, uint b) {
    return ((a & 0x00FEFEFEu) >> 1u) + ((b & 0x00FEFEFEu) >> 1u) + (a & b & 0x00010101u);
}

uint interp3_1(uint a, uint b) {
    return interp(a, interp(a, b));
}

// GetResult vote: bias toward a or b based on neighbors c, d.
int get_result(uint a, uint b, uint c, uint d) {
    int x = 0;
    int y = 0;
    if (a == c) x += 1; else if (b == c) y += 1;
    if (a == d) x += 1; else if (b == d) y += 1;
    int r = 0;
    if (x <= 1) r += 1;
    if (y <= 1) r -= 1;
    return r;
}

void main() {
    uint opx = gl_GlobalInvocationID.x;
    uint opy = gl_GlobalInvocationID.y;
    if (opx >= out_w || opy >= out_h) return;

    ivec2 out_pos = ivec2(opx, opy);
    ivec2 src_i = out_pos / 2;
    ivec2 sub = out_pos - src_i * 2;

    // Map to Kreed naming from 4x4 neighborhood
    uint color_b1 = fetch(src_i + ivec2( 0, -1));
    uint color_b2 = fetch(src_i + ivec2( 1, -1));
    uint color4   = fetch(src_i + ivec2(-1,  0));
    uint color5   = fetch(src_i + ivec2( 0,  0));  // center
    uint color6   = fetch(src_i + ivec2( 1,  0));  // right
    uint color_s2 = fetch(src_i + ivec2( 2,  0));
    uint color1   = fetch(src_i + ivec2(-1,  1));
    uint color2   = fetch(src_i + ivec2( 0,  1));  // below
    uint color3   = fetch(src_i + ivec2( 1,  1));  // below-right
    uint color_s1 = fetch(src_i + ivec2( 2,  1));
    uint color_a1 = fetch(src_i + ivec2( 0,  2));
    uint color_a2 = fetch(src_i + ivec2( 1,  2));

    uint e0, e1, e2, e3;

    if (color2 == color6 && color5 != color3) {
        // Anti-diagonal wins
        e1 = color2;
        e2 = color2;
        if ((color1 == color2 && color6 == color_s2)
            || (color2 == color_a1 && color6 == color_b2))
        {
            e0 = interp3_1(color2, color5);
            e3 = interp3_1(color2, color3);
        } else {
            e0 = interp(color5, color6);
            e3 = interp(color2, color3);
        }
    } else if (color5 == color3 && color2 != color6) {
        // Main diagonal wins
        e3 = color5;
        e0 = color5;
        if ((color_b1 == color5 && color3 == color_a2)
            || (color4 == color5 && color3 == color_s1))
        {
            e1 = interp3_1(color5, color6);
            e2 = interp3_1(color5, color2);
        } else {
            e1 = interp(color5, color6);
            e2 = interp(color2, color3);
        }
    } else if (color5 == color3 && color2 == color6 && color5 != color6) {
        // Both diagonals match — vote
        int r = get_result(color6, color5, color1, color_a1)
              + get_result(color6, color5, color4, color_b1)
              + get_result(color6, color5, color_a2, color_s1)
              + get_result(color6, color5, color_b2, color_s2);

        if (r > 0) {
            e1 = color2;
            e2 = color2;
            e0 = interp(color5, color6);
            e3 = interp(color5, color6);
        } else if (r < 0) {
            e0 = color5;
            e3 = color5;
            e1 = interp(color5, color6);
            e2 = interp(color5, color6);
        } else {
            e0 = color5;
            e3 = color5;
            e1 = color2;
            e2 = color2;
        }
    } else {
        if (color2 == color5 || color3 == color6) {
            e0 = color5;
            e1 = color6;
            e2 = color2;
            e3 = color3;
        } else {
            e0 = interp3_1(color5, color6);
            e1 = interp3_1(color6, color5);
            e2 = interp3_1(color2, color3);
            e3 = interp3_1(color3, color2);
        }
    }

    // Select output pixel based on sub-pixel position
    uint result;
    if (sub.x == 0 && sub.y == 0) result = e0;
    else if (sub.x == 1 && sub.y == 0) result = e1;
    else if (sub.x == 0 && sub.y == 1) result = e2;
    else result = e3;

    imageStore(output_img, ivec2(opx, opy), unpack(result));
}
