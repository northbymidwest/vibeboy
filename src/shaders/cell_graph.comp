#version 450

// Build cell graph: generate B-spline control points at grid corners.
//
// Each thread processes one grid corner (cx, cy) where
// 0 <= cx <= img_w and 0 <= cy <= img_h.
//
// At each interior corner, 4 pixels meet:
//   TL = (cx-1, cy-1)   TR = (cx, cy-1)
//   BL = (cx-1, cy)     BR = (cx, cy)
//
// Boundary edges separate dissimilar adjacent pixels.
// A diagonal crossing splits the corner into 2 CPs offset ±0.25.
// Each diagonal CP is only created if it has at least one boundary
// edge in its assigned directions (otherwise it would be disconnected).
//
// Flag encoding:
//   0 = inactive (no CP at this slot)
//   1 = pinned (junction or border — don't optimize)
//   2 = active chain node (can be optimized)

layout(local_size_x = 16, local_size_y = 16) in;

// Readonly: similarity graph from phase 1
layout(std430, set = 0, binding = 0) readonly buffer GraphBuf {
    uint graph[];
};

// Readwrite outputs
layout(std430, set = 1, binding = 0) buffer PosBuf {
    float positions[];
};

layout(std430, set = 1, binding = 1) buffer NbrBuf {
    int neighbors[];
};

layout(std430, set = 1, binding = 2) buffer FlagBuf {
    uint flags[];
};

layout(std140, set = 2, binding = 0) uniform Uniforms {
    uint img_w;
    uint img_h;
    uint graph_stride; // 2*img_w + 1
    uint corners_w;    // img_w + 1
};

const uint IS_CORNER = 16u;
const uint IS_TJUNCTION = 32u;

uint g(int gx, int gy) {
    gx = clamp(gx, 0, int(graph_stride) - 1);
    gy = clamp(gy, 0, int(2u * img_h));
    return graph[gy * int(graph_stride) + gx];
}

// Compute the actual CP position at a neighbor grid corner, accounting for
// which diagonal slot we'd connect to (from_dir determines the slot).
// Returns the neighbor CP position including any ±0.25 diagonal offset.
vec2 neighbor_cp_pos(int cx, int cy, int from_dir) {
    vec2 base_pos = vec2(float(cx), float(cy));

    // Border corners have no diagonal offset
    if (cx <= 0 || cy <= 0 || cx >= int(img_w) || cy >= int(img_h))
        return base_pos;

    uint diag = g(2 * cx, 2 * cy);
    bool is_ullr = (diag & 1u) != 0u && (diag & 2u) == 0u;
    bool is_llur = (diag & 2u) != 0u && (diag & 1u) == 0u;

    if (!is_ullr && !is_llur) return base_pos;

    // Backslash: slot 0 = SW at (-0.25, +0.25), slot 1 = NE at (+0.25, -0.25)
    // Slash:     slot 0 = NW at (-0.25, -0.25), slot 1 = SE at (+0.25, +0.25)
    int slot = 0;
    if (from_dir == 0) { if (is_llur) slot = 1; }
    else if (from_dir == 2) { if (is_ullr) slot = 1; }
    else if (from_dir == 3) { slot = 1; }
    // from_dir == 1: slot stays 0

    if (is_ullr) {
        return (slot == 0) ? base_pos + vec2(-0.25, 0.25)
                           : base_pos + vec2(0.25, -0.25);
    } else {
        return (slot == 0) ? base_pos + vec2(-0.25, -0.25)
                           : base_pos + vec2(0.25, 0.25);
    }
}

// Corner detection from Kopf-Lischinski reference implementation.
// Checks if the angle between two spline vectors matches known corner angles.
// The vectors point from the CP to each of its two neighbors.
bool checkForCorner(vec2 v1, vec2 v2) {
    float len1 = length(v1);
    float len2 = length(v2);
    if (len1 < 1e-6 || len2 < 1e-6) return false;
    float dp = dot(v1, v2) / (len1 * len2);
    // 90° corner (non-diagonal L-shape): dp ≈ 0
    if (dp > -0.01 && dp < 0.01) return true;
    // ~135° between vectors = 45° turn: dp ≈ -0.7071
    if (dp > -0.72 && dp < -0.69) return true;
    // ~108° between vectors = 72° turn: dp ≈ -0.3162
    if (dp > -0.33 && dp < -0.30) return true;
    return false;
}

int cp_base(int cx, int cy) {
    if (cx < 0 || cy < 0 || cx >= int(corners_w) || cy >= int(img_h + 1u))
        return -1;
    return (cy * int(corners_w) + cx) * 2;
}

// Get the correct CP index at a neighbor corner, accounting for diagonal splits.
// When a neighbor corner has a diagonal, the correct slot depends on which
// side of the diagonal we need — determined by the direction we're approaching from.
//
// For a backslash (\, ULLR) diagonal at the neighbor:
//   slot 0 = SW side (handles S and W connections)
//   slot 1 = NE side (handles N and E connections)
//
// For a slash (/, LLUR) diagonal at the neighbor:
//   slot 0 = NW side (handles N and W connections)
//   slot 1 = SE side (handles S and E connections)
//
// When we approach from a direction, we need the CP that handles the
// opposite direction at the neighbor (our N edge connects to neighbor's S, etc.):
//
//                 Backslash    Slash     None
//   from North → slot 0(SW)  slot 1(SE) slot 0
//   from East  → slot 0(SW)  slot 0(NW) slot 0
//   from South → slot 1(NE)  slot 0(NW) slot 0
//   from West  → slot 1(NE)  slot 1(SE) slot 0
int nbr_cp_idx(int cx, int cy, int from_dir) {
    int base = cp_base(cx, cy);
    if (base < 0) return -1;

    // Border corners never have diagonals
    if (cx <= 0 || cy <= 0 || cx >= int(img_w) || cy >= int(img_h))
        return base;

    // Read the diagonal state at this corner from the graph.
    // Graph even rows/cols store diagonal crossings.
    uint diag = g(2 * cx, 2 * cy);
    bool is_ullr = (diag & 1u) != 0u && (diag & 2u) == 0u; // backslash only
    bool is_llur = (diag & 2u) != 0u && (diag & 1u) == 0u; // slash only

    if (!is_ullr && !is_llur) return base; // no diagonal → slot 0

    int slot = 0;
    if (from_dir == 0) { // approaching from North → need neighbor's S side
        // backslash S → slot 0 (SW); slash S → slot 1 (SE)
        if (is_llur) slot = 1;
    } else if (from_dir == 1) { // approaching from East → need neighbor's W side
        // backslash W → slot 0 (SW)? No — wait.
        // Actually: we approach from East means our E edge connects to neighbor's W.
        // backslash W is handled by SW CP → slot 0? No, let me re-derive.
        //
        // backslash: slot 0 = SW handles S,W. slot 1 = NE handles N,E.
        // We need W side → SW CP → slot 0. ✓
        // slash: slot 0 = NW handles N,W. slot 1 = SE handles S,E.
        // We need W side → NW CP → slot 0. ✓
        // slot stays 0
    } else if (from_dir == 2) { // approaching from South → need neighbor's N side
        // backslash N → NE CP → slot 1; slash N → NW CP → slot 0
        if (is_ullr) slot = 1;
    } else { // from_dir == 3, approaching from West → need neighbor's E side
        // backslash E → NE CP → slot 1; slash E → SE CP → slot 1
        slot = 1; // both diagonal types → slot 1
        if (!is_ullr && !is_llur) slot = 0; // no diagonal (already handled above)
    }

    return base + slot;
}


void write_cp_full(int idx, vec2 pos, int prev, int next, uint flag,
                   int prev_dir, int next_dir, int icx, int icy) {
    positions[idx * 2] = pos.x;
    positions[idx * 2 + 1] = pos.y;
    neighbors[idx * 4] = prev;
    neighbors[idx * 4 + 1] = next;
    neighbors[idx * 4 + 2] = prev_dir;
    neighbors[idx * 4 + 3] = next_dir;
    flags[idx] = flag;
}

void write_cp(int idx, vec2 pos, int prev, int next, uint flag) {
    positions[idx * 2] = pos.x;
    positions[idx * 2 + 1] = pos.y;
    neighbors[idx * 4] = prev;
    neighbors[idx * 4 + 1] = next;
    neighbors[idx * 4 + 2] = -1;
    neighbors[idx * 4 + 3] = -1;
    flags[idx] = flag;
}

// Check if two adjacent pixels are similar using the graph.
// Returns true if pixels are connected (same region).
bool similar(int px0, int py0, int px1, int py1) {
    int dx = px1 - px0;
    int dy = py1 - py0;
    int gx = 2 * px0 + 1;
    int gy = 2 * py0 + 1;

    if (dx == 1 && dy == 0) return g(gx + 1, gy) != 0u;
    if (dx == -1 && dy == 0) return g(gx - 1, gy) != 0u;
    if (dx == 0 && dy == 1) return g(gx, gy + 1) != 0u;
    if (dx == 0 && dy == -1) return g(gx, gy - 1) != 0u;
    return false;
}

void main() {
    uint cx = gl_GlobalInvocationID.x;
    uint cy = gl_GlobalInvocationID.y;
    if (cx > img_w || cy > img_h) return;

    int base = cp_base(int(cx), int(cy));
    if (base < 0) return;

    // Default: both slots inactive
    write_cp(base, vec2(0.0, 0.0), -1, -1, 0u);
    write_cp(base + 1, vec2(0.0, 0.0), -1, -1, 0u);

    bool is_interior = cx > 0u && cy > 0u && cx < img_w && cy < img_h;

    if (!is_interior) {
        // Border corners: create a pinned CP if any adjacent edge is a boundary.
        bool has_boundary = false;
        if (cy == 0u && cx > 0u && cx < img_w) {
            has_boundary = !similar(int(cx) - 1, 0, int(cx), 0);
        }
        if (cy == img_h && cx > 0u && cx < img_w) {
            has_boundary = has_boundary || !similar(int(cx) - 1, int(img_h) - 1, int(cx), int(img_h) - 1);
        }
        if (cx == 0u && cy > 0u && cy < img_h) {
            has_boundary = has_boundary || !similar(0, int(cy) - 1, 0, int(cy));
        }
        if (cx == img_w && cy > 0u && cy < img_h) {
            has_boundary = has_boundary || !similar(int(img_w) - 1, int(cy) - 1, int(img_w) - 1, int(cy));
        }
        if (has_boundary) {
            write_cp(base, vec2(float(cx), float(cy)), -1, -1, 1u); // pinned border CP
        }
        return;
    }

    // Interior corner: 4 pixels meet here
    // TL = (cx-1, cy-1), TR = (cx, cy-1), BL = (cx-1, cy), BR = (cx, cy)

    // Diagonal state at this corner
    uint diag = g(int(2u * cx), int(2u * cy));
    bool has_main = (diag & 1u) != 0u; // backslash (\): TL↔BR connected
    bool has_anti = (diag & 2u) != 0u; // slash (/): TR↔BL connected

    // Check which of the 4 boundary edges exist.
    // North: TL vs TR
    bool bnd_n = !similar(int(cx) - 1, int(cy) - 1, int(cx), int(cy) - 1);
    // East: TR vs BR
    bool bnd_e = !similar(int(cx), int(cy) - 1, int(cx), int(cy));
    // South: BL vs BR
    bool bnd_s = !similar(int(cx) - 1, int(cy), int(cx), int(cy));
    // West: TL vs BL
    bool bnd_w = !similar(int(cx) - 1, int(cy) - 1, int(cx) - 1, int(cy));

    uint bnd_count = (bnd_n ? 1u : 0u) + (bnd_e ? 1u : 0u)
                   + (bnd_s ? 1u : 0u) + (bnd_w ? 1u : 0u);

    // No boundary edges → interior of uniform region → no CP
    if (bnd_count == 0u) return;

    // Handle diagonal crossings: split into 2 CPs
    if (has_main && !has_anti) {
        // Backslash (\): TL↔BR connected
        // CP0 (slot 0) = SW side at (cx-0.25, cy+0.25), handles S and W
        // CP1 (slot 1) = NE side at (cx+0.25, cy-0.25), handles N and E

        bool cp0_has_s = bnd_s;
        bool cp0_has_w = bnd_w;
        bool cp1_has_n = bnd_n;
        bool cp1_has_e = bnd_e;

        bool cp0_alive = cp0_has_s || cp0_has_w;
        bool cp1_alive = cp1_has_n || cp1_has_e;

        if (cp0_alive) {
            vec2 p0 = vec2(float(cx) - 0.25, float(cy) + 0.25);
            int prev0 = cp0_has_s ? nbr_cp_idx(int(cx), int(cy) + 1, 2) : -1;
            int next0 = cp0_has_w ? nbr_cp_idx(int(cx) - 1, int(cy), 3) : -1;
            bool cp0_junction = !(cp0_has_s && cp0_has_w);
            uint cp0_flag = cp0_junction ? 1u : 2u;
            if (!cp0_junction) {
                vec2 s_pos = neighbor_cp_pos(int(cx), int(cy) + 1, 2);
                vec2 w_pos = neighbor_cp_pos(int(cx) - 1, int(cy), 3);
                if (checkForCorner(s_pos - p0, w_pos - p0)) cp0_flag |= IS_CORNER;
            }
            // Backslash SW: prev=S(2), next=W(3)
            int d0_prev = cp0_has_s ? 2 : -1;
            int d0_next = cp0_has_w ? 3 : -1;
            write_cp_full(base, p0, prev0, next0, cp0_flag, d0_prev, d0_next, int(cx), int(cy));
        }

        if (cp1_alive) {
            vec2 p1 = vec2(float(cx) + 0.25, float(cy) - 0.25);
            int prev1 = cp1_has_n ? nbr_cp_idx(int(cx), int(cy) - 1, 0) : -1;
            int next1 = cp1_has_e ? nbr_cp_idx(int(cx) + 1, int(cy), 1) : -1;
            bool cp1_junction = !(cp1_has_n && cp1_has_e);
            uint cp1_flag = cp1_junction ? 1u : 2u;
            if (!cp1_junction) {
                vec2 n_pos = neighbor_cp_pos(int(cx), int(cy) - 1, 0);
                vec2 e_pos = neighbor_cp_pos(int(cx) + 1, int(cy), 1);
                if (checkForCorner(n_pos - p1, e_pos - p1)) cp1_flag |= IS_CORNER;
            }
            // Backslash NE: prev=N(0), next=E(1)
            int d1_prev = cp1_has_n ? 0 : -1;
            int d1_next = cp1_has_e ? 1 : -1;
            write_cp_full(base + 1, p1, prev1, next1, cp1_flag, d1_prev, d1_next, int(cx), int(cy));
        }
        return;
    }

    if (has_anti && !has_main) {
        // Slash (/): TR↔BL connected
        // CP0 (slot 0) = NW side at (cx-0.25, cy-0.25), handles N and W
        // CP1 (slot 1) = SE side at (cx+0.25, cy+0.25), handles S and E

        bool cp0_has_n = bnd_n;
        bool cp0_has_w = bnd_w;
        bool cp1_has_s = bnd_s;
        bool cp1_has_e = bnd_e;

        bool cp0_alive = cp0_has_n || cp0_has_w;
        bool cp1_alive = cp1_has_s || cp1_has_e;

        if (cp0_alive) {
            vec2 p0 = vec2(float(cx) - 0.25, float(cy) - 0.25);
            int prev0 = cp0_has_n ? nbr_cp_idx(int(cx), int(cy) - 1, 0) : -1;
            int next0 = cp0_has_w ? nbr_cp_idx(int(cx) - 1, int(cy), 3) : -1;
            bool cp0_junction = !(cp0_has_n && cp0_has_w);
            uint cp0_flag = cp0_junction ? 1u : 2u;
            if (!cp0_junction) {
                vec2 n_pos = neighbor_cp_pos(int(cx), int(cy) - 1, 0);
                vec2 w_pos = neighbor_cp_pos(int(cx) - 1, int(cy), 3);
                if (checkForCorner(n_pos - p0, w_pos - p0)) cp0_flag |= IS_CORNER;
            }
            // Slash NW: prev=N(0), next=W(3)
            int d0_prev = cp0_has_n ? 0 : -1;
            int d0_next = cp0_has_w ? 3 : -1;
            write_cp_full(base, p0, prev0, next0, cp0_flag, d0_prev, d0_next, int(cx), int(cy));
        }

        if (cp1_alive) {
            vec2 p1 = vec2(float(cx) + 0.25, float(cy) + 0.25);
            int prev1 = cp1_has_s ? nbr_cp_idx(int(cx), int(cy) + 1, 2) : -1;
            int next1 = cp1_has_e ? nbr_cp_idx(int(cx) + 1, int(cy), 1) : -1;
            bool cp1_junction = !(cp1_has_s && cp1_has_e);
            uint cp1_flag = cp1_junction ? 1u : 2u;
            if (!cp1_junction) {
                vec2 s_pos = neighbor_cp_pos(int(cx), int(cy) + 1, 2);
                vec2 e_pos = neighbor_cp_pos(int(cx) + 1, int(cy), 1);
                if (checkForCorner(s_pos - p1, e_pos - p1)) cp1_flag |= IS_CORNER;
            }
            // Slash SE: prev=S(2), next=E(1)
            int d1_prev = cp1_has_s ? 2 : -1;
            int d1_next = cp1_has_e ? 1 : -1;
            write_cp_full(base + 1, p1, prev1, next1, cp1_flag, d1_prev, d1_next, int(cx), int(cy));
        }
        return;
    }

    // No diagonal (or both diagonals kept → treat as no split): single CP
    vec2 pos = vec2(float(cx), float(cy));

    // Compute neighbor indices for boundary directions
    int n_idx = bnd_n ? nbr_cp_idx(int(cx), int(cy) - 1, 0) : -1;
    int e_idx = bnd_e ? nbr_cp_idx(int(cx) + 1, int(cy), 1) : -1;
    int s_idx = bnd_s ? nbr_cp_idx(int(cx), int(cy) + 1, 2) : -1;
    int w_idx = bnd_w ? nbr_cp_idx(int(cx) - 1, int(cy), 3) : -1;

    if (bnd_count == 2u) {
        // Regular chain node: exactly 2 boundary edges → prev and next
        int prev = -1, next = -1;
        // Track which directions connect to prev and next
        int prev_dir = -1, next_dir = -1;
        if (bnd_n) { if (prev < 0) { prev = n_idx; prev_dir = 0; } else { next = n_idx; next_dir = 0; } }
        if (bnd_e) { if (prev < 0) { prev = e_idx; prev_dir = 1; } else { next = e_idx; next_dir = 1; } }
        if (bnd_s) { if (prev < 0) { prev = s_idx; prev_dir = 2; } else { next = s_idx; next_dir = 2; } }
        if (bnd_w) { if (prev < 0) { prev = w_idx; prev_dir = 3; } else { next = w_idx; next_dir = 3; } }
        // Corner detection using reference implementation's checkForCorner.
        // Compute actual neighbor CP positions (with diagonal offsets).
        uint flag = 2u;
        if (prev_dir >= 0 && next_dir >= 0) {
            int prev_cx = int(cx) + ((prev_dir == 1) ? 1 : (prev_dir == 3) ? -1 : 0);
            int prev_cy = int(cy) + ((prev_dir == 2) ? 1 : (prev_dir == 0) ? -1 : 0);
            int next_cx = int(cx) + ((next_dir == 1) ? 1 : (next_dir == 3) ? -1 : 0);
            int next_cy = int(cy) + ((next_dir == 2) ? 1 : (next_dir == 0) ? -1 : 0);
            vec2 prev_pos = neighbor_cp_pos(prev_cx, prev_cy, prev_dir);
            vec2 next_pos = neighbor_cp_pos(next_cx, next_cy, next_dir);
            if (checkForCorner(prev_pos - pos, next_pos - pos))
                flag |= IS_CORNER;
        }
        write_cp_full(base, pos, prev, next, flag, prev_dir, next_dir, int(cx), int(cy));

    } else if (bnd_count == 1u) {
        // Valence-1 endpoint — pinned junction
        int nbr = -1; int nbr_dir = -1;
        if (bnd_n) { nbr = n_idx; nbr_dir = 0; }
        else if (bnd_e) { nbr = e_idx; nbr_dir = 1; }
        else if (bnd_s) { nbr = s_idx; nbr_dir = 2; }
        else { nbr = w_idx; nbr_dir = 3; }
        write_cp_full(base, pos, nbr, -1, 1u, nbr_dir, -1, int(cx), int(cy));

    } else if (bnd_count == 3u) {
        // T-junction (valence 3): pick 2 of 3 edges as the spline pair.
        // The shading edge (non-spline) is the one with the smallest color
        // distance across it. For now, use a simple heuristic: pick the pair
        // that forms the straightest path (N-S or E-W if both present).
        int prev = -1, next = -1;
        int t_prev_dir = -1, t_next_dir = -1;

        if (bnd_n && bnd_s) {
            prev = n_idx; next = s_idx; t_prev_dir = 0; t_next_dir = 2;
        } else if (bnd_e && bnd_w) {
            prev = e_idx; next = w_idx; t_prev_dir = 1; t_next_dir = 3;
        } else if (bnd_n && bnd_e) {
            prev = n_idx; next = e_idx; t_prev_dir = 0; t_next_dir = 1;
        } else if (bnd_n && bnd_w) {
            prev = n_idx; next = w_idx; t_prev_dir = 0; t_next_dir = 3;
        } else if (bnd_s && bnd_e) {
            prev = s_idx; next = e_idx; t_prev_dir = 2; t_next_dir = 1;
        } else {
            prev = s_idx; next = w_idx; t_prev_dir = 2; t_next_dir = 3;
        }

        // T-junction position correction: 0.125*p_prev + 0.75*p + 0.125*p_next
        // Use grid corner positions as approximation (can't read other CPs yet).
        if (prev >= 0 && next >= 0) {
            int prev_slot = prev / 2;
            int prev_cx = prev_slot % int(corners_w);
            int prev_cy = prev_slot / int(corners_w);
            int next_slot = next / 2;
            int next_cx = next_slot % int(corners_w);
            int next_cy = next_slot / int(corners_w);
            pos = vec2(
                0.125 * float(prev_cx) + 0.75 * float(cx) + 0.125 * float(next_cx),
                0.125 * float(prev_cy) + 0.75 * float(cy) + 0.125 * float(next_cy)
            );
        }

        write_cp_full(base, pos, prev, next, 2u | IS_TJUNCTION, t_prev_dir, t_next_dir, int(cx), int(cy));

        // Create endpoint CP at slot 1 for the 3rd (dropped) boundary direction.
        // Without this, the rasterizer can't find the stem boundary at T-junctions.
        int stem_idx = -1;
        int stem_dir = -1;
        if (bnd_n && t_prev_dir != 0 && t_next_dir != 0) { stem_idx = n_idx; stem_dir = 0; }
        else if (bnd_e && t_prev_dir != 1 && t_next_dir != 1) { stem_idx = e_idx; stem_dir = 1; }
        else if (bnd_s && t_prev_dir != 2 && t_next_dir != 2) { stem_idx = s_idx; stem_dir = 2; }
        else if (bnd_w && t_prev_dir != 3 && t_next_dir != 3) { stem_idx = w_idx; stem_dir = 3; }
        if (stem_idx >= 0) {
            // Use the chain CP's adjusted position so the stem terminates
            // exactly where the chain passes through the junction.
            write_cp_full(base + 1, pos, stem_idx, -1, 1u, stem_dir, -1, int(cx), int(cy));
        }

    } else {
        // Valence 4 cross-junction: pinned, pick N-S as spline pair
        write_cp_full(base, pos, n_idx, s_idx, 1u, 0, 2, int(cx), int(cy));
    }
}
