#version 450

// Tile-based nearest-boundary cell rasterizer with adaptive 2×2 AA.
//
// Each workgroup handles a 2×2 source-pixel tile. CPs in the tile's
// neighborhood are loaded into shared memory ONCE, then all output
// pixels in the tile evaluate against shared memory — no redundant
// global reads. Massive speedup for dense scenes.
//
// Uses a slim shared-memory struct (SlimCP) for the distance scan,
// with resolve-only data read lazily from global memory for the 1-4
// winning CPs per pixel. This halves shared memory usage vs storing
// all fields, improving GPU occupancy.

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) readonly buffer PixelBuf {
    uint pixels[];
};

layout(std430, set = 0, binding = 1) readonly buffer PosBuf {
    float cp_positions[];
};

layout(std430, set = 0, binding = 2) readonly buffer OrigPosBuf {
    float orig_positions[];
};

layout(std430, set = 0, binding = 3) readonly buffer FlagBuf {
    uint cp_flags[];
};

layout(std430, set = 0, binding = 4) readonly buffer NbrBuf {
    int cp_neighbors[];
};

layout(set = 1, binding = 0, rgba8) writeonly uniform image2D output_img;

layout(std140, set = 2, binding = 0) uniform Uniforms {
    uint img_w;
    uint img_h;
    uint out_w;
    uint out_h;
    float scale;
    uint corners_w;
    uint tiles_w;   // ceil(img_w / 2)
    uint tiles_h;   // ceil(img_h / 2)
};

// Slim shared-memory struct: only fields needed for the distance scan.
// Resolve-only data (orig positions, directions, corner coords) is read
// lazily from global memory for the 1-4 winning CPs per pixel.
const uint MAX_TILE_CPS = 98u;  // 7×7 corners × 2 slots

struct SlimCP {
    vec2 pos;        // optimized position (control point)
    vec2 prev_pos;   // prev neighbor optimized position
    vec2 next_pos;   // next neighbor optimized position
    vec2 bbox_min;   // axis-aligned bounding box of span (prev, pos, next)
    vec2 bbox_max;
    int ci;          // global CP index for lazy global reads
    int _pad;
};

shared SlimCP sh_cps[MAX_TILE_CPS];
shared uint sh_num_cps;

// Resolve-only data, loaded lazily from global memory for winning CPs.
struct ResolveData {
    vec2 orig_pos;
    vec2 orig_prev;
    vec2 orig_next;
    int prev_dir;
    int next_dir;
    uint icx, icy;
    int prev_ci;
    int next_ci;
};

vec2 read_pos(int idx) {
    if (idx < 0) return vec2(-1e10);
    return vec2(cp_positions[idx * 2], cp_positions[idx * 2 + 1]);
}

vec2 read_orig(int idx) {
    if (idx < 0) return vec2(-1e10);
    return vec2(orig_positions[idx * 2], orig_positions[idx * 2 + 1]);
}

// Load resolve-only data from global buffers. Only called for the 1-4
// winning CPs per pixel, never during the distance scan.
ResolveData read_resolve_data(int ci) {
    ResolveData rd;
    rd.prev_ci = cp_neighbors[ci * 4];
    rd.next_ci = cp_neighbors[ci * 4 + 1];
    rd.prev_dir = cp_neighbors[ci * 4 + 2];
    rd.next_dir = cp_neighbors[ci * 4 + 3];
    rd.orig_pos = read_orig(ci);
    rd.orig_prev = (rd.prev_ci >= 0) ? read_orig(rd.prev_ci) : rd.orig_pos;
    rd.orig_next = (rd.next_ci >= 0) ? read_orig(rd.next_ci) : rd.orig_pos;
    rd.icx = uint((ci / 2) % int(corners_w));
    rd.icy = uint((ci / 2) / int(corners_w));
    return rd;
}

vec2 beval(vec2 p0, vec2 p1, vec2 p2, float t) {
    float u = 1.0 - t;
    return 0.5 * u * u * p0 + (u * t + 0.5) * p1 + 0.5 * t * t * p2;
}

vec2 beval_deriv(vec2 p0, vec2 p1, vec2 p2, float t) {
    return (t - 1.0) * p0 + (1.0 - 2.0 * t) * p1 + t * p2;
}

uint get_px_color(int px, int py) {
    px = clamp(px, 0, int(img_w) - 1);
    py = clamp(py, 0, int(img_h) - 1);
    return pixels[py * int(img_w) + px];
}

void get_edge_colors(uint icx, uint icy, int dir, out uint color_left, out uint color_right) {
    switch (dir) {
        case 0: color_left = get_px_color(int(icx)-1, int(icy)-1); color_right = get_px_color(int(icx), int(icy)-1); break;
        case 1: color_left = get_px_color(int(icx), int(icy)-1); color_right = get_px_color(int(icx), int(icy)); break;
        case 2: color_left = get_px_color(int(icx), int(icy)); color_right = get_px_color(int(icx)-1, int(icy)); break;
        case 3: color_left = get_px_color(int(icx)-1, int(icy)); color_right = get_px_color(int(icx)-1, int(icy)-1); break;
        default: color_left = 0u; color_right = 0u; break;
    }
}

// Resolve color for a hit CP. Uses SlimCP (pos/prev/next from shared memory)
// and ResolveData (orig positions, directions from global memory).
// Returns true if resolved, false if this hit should be skipped.
bool resolve_color(vec2 pt, SlimCP sc, ResolveData rd, float t, out uint out_color) {
    uint pl = 0u, pr = 0u, nl = 0u, nr = 0u;
    if (rd.prev_dir >= 0) get_edge_colors(rd.icx, rd.icy, rd.prev_dir, pl, pr);
    if (rd.next_dir >= 0) get_edge_colors(rd.icx, rd.icy, rd.next_dir, nl, nr);

    uint color_left = 0u, color_right = 0u;
    float ref_t;
    bool prev_valid = (pl != pr);
    bool next_valid = (nl != nr);

    if (rd.prev_ci < 0) {
        vec2 toward = sc.next_pos - sc.pos;
        if (dot(pt - sc.pos, toward) < 0.0) return false;
        if (next_valid) { color_left = nr; color_right = nl; ref_t = 1.0; }
        else return false;
    } else if (rd.next_ci < 0) {
        vec2 toward = sc.prev_pos - sc.pos;
        if (dot(pt - sc.pos, toward) < 0.0) return false;
        if (prev_valid) { color_left = pl; color_right = pr; ref_t = 0.0; }
        else return false;
    } else if (t < 0.5) {
        if (prev_valid) { color_left = pl; color_right = pr; ref_t = 0.0; }
        else if (next_valid) { color_left = nr; color_right = nl; ref_t = 1.0; }
        else return false;
    } else {
        if (next_valid) { color_left = nr; color_right = nl; ref_t = 1.0; }
        else if (prev_valid) { color_left = pl; color_right = pr; ref_t = 0.0; }
        else return false;
    }

    vec2 orig_tangent = beval_deriv(rd.orig_prev, rd.orig_pos, rd.orig_next, ref_t);
    float tl2 = length(orig_tangent);
    if (tl2 < 1e-4) return false;
    orig_tangent /= tl2;
    vec2 orig_normal = vec2(-orig_tangent.y, orig_tangent.x);

    vec2 cpt = beval(sc.prev_pos, sc.pos, sc.next_pos, t);
    vec2 opt_tangent = beval_deriv(sc.prev_pos, sc.pos, sc.next_pos, t);
    float otl = length(opt_tangent);
    if (otl < 1e-4) return false;
    opt_tangent /= otl;
    vec2 opt_normal = vec2(-opt_tangent.y, opt_tangent.x);

    bool normals_agree = dot(opt_normal, orig_normal) > 0.0;
    float side = dot(pt - cpt, opt_normal);
    if (normals_agree) {
        out_color = (side > 0.0) ? color_left : color_right;
    } else {
        out_color = (side > 0.0) ? color_right : color_left;
    }
    return true;
}

// Cheap 3-point distance screening using B-spline endpoints + midpoint.
// Endpoints are trivial averages (no full beval needed):
//   B(0)   = 0.5*(p0+p1)
//   B(0.5) = 0.125*p0 + 0.75*p1 + 0.125*p2
//   B(1)   = 0.5*(p1+p2)
// Returns vec2(best_t, min_d2) where t in {0.0, 0.5, 1.0}.
vec2 quick_screen(vec2 p0, vec2 p1, vec2 p2, vec2 pt) {
    vec2 b0 = 0.5 * (p0 + p1);
    vec2 bm = 0.125 * p0 + 0.75 * p1 + 0.125 * p2;
    vec2 b1 = 0.5 * (p1 + p2);

    float dd0 = dot(pt - b0, pt - b0);
    float ddm = dot(pt - bm, pt - bm);
    float dd1 = dot(pt - b1, pt - b1);

    float best = dd0; float t = 0.0;
    if (ddm < best) { best = ddm; t = 0.5; }
    if (dd1 < best) { best = dd1; t = 1.0; }
    return vec2(t, best);
}

// Full refinement, seeded from quick_screen results.
// Adds quarter-point samples (t=0.25, 0.75) and 3 Newton-Raphson iterations.
// The 5-point seeding (3 from quick_screen + 2 here) gives excellent Newton
// convergence, making 3 iterations sufficient (was 4 without seeding).
vec2 refine_closest(vec2 p0, vec2 p1, vec2 p2, vec2 pt,
                    float seed_t, float seed_d2) {
    float best_d2 = seed_d2;
    float best_t = seed_t;

    // Quarter-point samples (endpoints + midpoint already checked)
    vec2 bq1 = beval(p0, p1, p2, 0.25);
    float dq1 = dot(pt - bq1, pt - bq1);
    if (dq1 < best_d2) { best_d2 = dq1; best_t = 0.25; }

    vec2 bq3 = beval(p0, p1, p2, 0.75);
    float dq3 = dot(pt - bq3, pt - bq3);
    if (dq3 < best_d2) { best_d2 = dq3; best_t = 0.75; }

    // Newton-Raphson: minimize D(t) = |B(t) - pt|^2
    // D'(t) = 2 * B'(t) . (B(t) - pt)
    // D''(t) = 2 * (B''(t) . (B(t) - pt) + |B'(t)|^2)
    // B''(t) is constant for quadratic: p0 - 2*p1 + p2
    vec2 b2 = p0 - 2.0 * p1 + p2;
    for (int i = 0; i < 3; i++) {
        vec2 bt = beval(p0, p1, p2, best_t);
        vec2 bt1 = beval_deriv(p0, p1, p2, best_t);
        vec2 diff = bt - pt;
        float f = dot(bt1, diff);
        float g = dot(b2, diff) + dot(bt1, bt1);
        if (abs(g) > 1e-10)
            best_t = clamp(best_t - f / g, 0.0, 1.0);
    }

    vec2 bp = beval(p0, p1, p2, best_t);
    best_d2 = dot(pt - bp, pt - bp);
    return vec2(best_t, best_d2);
}

// Single-pass: find nearest CPs, resolve color, and return hit info.
// Scans all CPs exactly once (builds top-4 sorted list for resolve fallback,
// and tracks absolute nearest for AA threshold).
uint sample_from_shared(vec2 pt, uint fallback_color,
                        out int out_idx, out float out_t, out float out_d2) {
    struct SHit { float d2; float t; int idx; };
    SHit hits[4];
    int num_hits = 0;
    for (int i = 0; i < 4; i++) { hits[i].d2 = 1e10; hits[i].idx = -1; }

    uint n = sh_num_cps;
    for (uint i = 0u; i < n; i++) {
        SlimCP sc = sh_cps[i];

        // Level 1: bbox rejection (4 comparisons, cheapest pre-filter)
        if (pt.x < sc.bbox_min.x - 1.0 || pt.x > sc.bbox_max.x + 1.0 ||
            pt.y < sc.bbox_min.y - 1.0 || pt.y > sc.bbox_max.y + 1.0)
            continue;

        // Level 2: cheap 3-point curve distance screening (~15 FMAs).
        // Evaluates B-spline at t=0, 0.5, 1.0 using endpoint averages.
        // The min of these is an upper bound on the true closest distance.
        // Safe to reject at 2.0: max approximation error for pixel-art
        // quadratic B-splines is ~0.125px, so true_d > sqrt(2.0)-0.125 > 1.0.
        vec2 quick = quick_screen(sc.prev_pos, sc.pos, sc.next_pos, pt);
        if (quick.y > 2.0) continue;

        // Level 3: full refinement on surviving candidates.
        // Reuses the 3-point seed, adds quarter-points + 3 Newton iterations.
        vec2 result = refine_closest(sc.prev_pos, sc.pos, sc.next_pos, pt,
                                     quick.x, quick.y);
        float span_best_t = result.x;
        float span_best_d2 = result.y;

        if (span_best_d2 < 1.0) {
            for (int h = 0; h < 4; h++) {
                if (span_best_d2 < hits[h].d2) {
                    for (int j = 3; j > h; j--) hits[j] = hits[j-1];
                    hits[h].d2 = span_best_d2;
                    hits[h].t = span_best_t;
                    hits[h].idx = int(i);
                    if (num_hits < 4) num_hits++;
                    break;
                }
            }
        }
    }

    // Return absolute nearest hit info (hits[0] is nearest since sorted)
    out_idx = (num_hits > 0) ? hits[0].idx : -1;
    out_t = (num_hits > 0) ? hits[0].t : 0.0;
    out_d2 = (num_hits > 0) ? hits[0].d2 : 1e10;

    // Try each hit until one resolves — lazily load resolve data from global memory
    for (int h = 0; h < num_hits; h++) {
        SlimCP sc = sh_cps[uint(hits[h].idx)];
        ResolveData rd = read_resolve_data(sc.ci);
        uint c;
        if (resolve_color(pt, sc, rd, hits[h].t, c)) {
            return c;
        }
    }
    return fallback_color;
}

void main() {
    // Each workgroup = one 2×2 source tile
    uint tile_idx = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;

    uint tile_x = tile_idx % tiles_w;
    uint tile_y = tile_idx / tiles_w;
    bool valid_tile = (tile_y < tiles_h);

    // Source-space bounds of this tile
    int src_x0 = int(tile_x) * 2;
    int src_y0 = int(tile_y) * 2;

    // Phase 1: Cooperatively load CPs into shared memory (slim struct only).
    // Barriers must be unconditional for WebGPU WGSL uniformity rules
    // (naga copies workgroup_id to a private var, losing uniformity proof).
    if (tid == 0u) sh_num_cps = 0u;
    barrier();

    if (valid_tile) {
        int center_cx = src_x0 + 1;
        int center_cy = src_y0 + 1;

        for (uint slot_idx = tid; slot_idx < 98u; slot_idx += 256u) {
            int local_idx = int(slot_idx) / 2;
            int slot = int(slot_idx) % 2;
            int dy = local_idx / 7 - 3;
            int dx = local_idx % 7 - 3;
            int cx = center_cx + dx;
            int cy = center_cy + dy;

            if (cx < 0 || cy < 0 || cx >= int(corners_w) || cy > int(img_h)) continue;
            int ci = (cy * int(corners_w) + cx) * 2 + slot;
            uint flag = cp_flags[ci];
            if (flag == 0u) continue;

            int prev_ci = cp_neighbors[ci * 4];
            int next_ci = cp_neighbors[ci * 4 + 1];
            if (prev_ci < 0 && next_ci < 0) continue;

            uint idx = atomicAdd(sh_num_cps, 1u);
            if (idx < MAX_TILE_CPS) {
                vec2 cp = read_pos(ci);
                vec2 pp = (prev_ci >= 0) ? read_pos(prev_ci) : cp;
                vec2 np = (next_ci >= 0) ? read_pos(next_ci) : cp;
                sh_cps[idx].pos = cp;
                sh_cps[idx].prev_pos = pp;
                sh_cps[idx].next_pos = np;
                sh_cps[idx].bbox_min = min(min(pp, cp), np);
                sh_cps[idx].bbox_max = max(max(pp, cp), np);
                sh_cps[idx].ci = ci;
            }
        }
    }
    barrier();

    if (!valid_tile) return;

    // Phase 2: Each thread processes output pixels in the tile.
    // Compute exact output pixel range from source tile bounds.
    uint out_x0 = uint(floor(float(src_x0) * scale));
    uint out_y0 = uint(floor(float(src_y0) * scale));
    uint out_x1 = min(uint(ceil(float(src_x0 + 2) * scale)), out_w);
    uint out_y1 = min(uint(ceil(float(src_y0 + 2) * scale)), out_h);
    uint tile_out_w = out_x1 - out_x0;
    uint tile_out_h = out_y1 - out_y0;
    uint pixels_per_tile = tile_out_w * tile_out_h;

    for (uint px_idx = tid; px_idx < pixels_per_tile; px_idx += 256u) {
        uint local_x = px_idx % tile_out_w;
        uint local_y = px_idx / tile_out_w;
        uint opx = out_x0 + local_x;
        uint opy = out_y0 + local_y;
        if (opx >= out_w || opy >= out_h) continue;

        float inv_scale = 1.0 / scale;
        vec2 center = vec2(float(opx) + 0.5, float(opy) + 0.5) * inv_scale;

        // Fallback: color of source pixel at this position
        int fb_x = clamp(int(floor(center.x)), 0, int(img_w) - 1);
        int fb_y = clamp(int(floor(center.y)), 0, int(img_h) - 1);
        uint fallback = pixels[fb_y * int(img_w) + fb_x];

        int best_idx = -1;
        float best_t = 0.0;
        float best_d2 = 1e10;
        uint center_color = sample_from_shared(center, fallback, best_idx, best_t, best_d2);

        // AA needed if nearest boundary is within the pixel diagonal.
        // Pixel side = 1/scale in source coords, diagonal = sqrt(2)/scale.
        // Threshold in d2: (sqrt(2)/scale)^2 = 2/scale^2.
        float aa_threshold = 2.0 / (scale * scale);
        bool need_aa = (best_idx >= 0 && best_d2 < aa_threshold);

        if (!need_aa) {
            imageStore(output_img, ivec2(opx, opy), vec4(
                float((center_color >> 16u) & 0xFFu) / 255.0,
                float((center_color >> 8u) & 0xFFu) / 255.0,
                float(center_color & 0xFFu) / 255.0, 1.0));
        } else {
            // Analytical AA: determine both colors from the nearest boundary's
            // edge colors directly, avoiding a second full CP scan.
            // Lazily load resolve data from global memory for this one CP.
            SlimCP sc = sh_cps[uint(best_idx)];
            ResolveData rd = read_resolve_data(sc.ci);

            vec2 cpt = beval(sc.prev_pos, sc.pos, sc.next_pos, best_t);
            vec2 tang = beval_deriv(sc.prev_pos, sc.pos, sc.next_pos, best_t);
            float tl = length(tang);

            if (tl < 1e-4) {
                imageStore(output_img, ivec2(opx, opy), vec4(
                    float((center_color >> 16u) & 0xFFu) / 255.0,
                    float((center_color >> 8u) & 0xFFu) / 255.0,
                    float(center_color & 0xFFu) / 255.0, 1.0));
            } else {
                vec2 normal = vec2(-tang.y, tang.x) / tl;
                float d = dot(center - cpt, normal);

                // Compute edge colors on-the-fly from pixel buffer
                uint aa_pl = 0u, aa_pr = 0u, aa_nl = 0u, aa_nr = 0u;
                if (rd.prev_dir >= 0) get_edge_colors(rd.icx, rd.icy, rd.prev_dir, aa_pl, aa_pr);
                if (rd.next_dir >= 0) get_edge_colors(rd.icx, rd.icy, rd.next_dir, aa_nl, aa_nr);

                // Resolve both colors from edge colors without a second scan.
                // Pick the edge (prev or next) based on t, then use normal
                // direction to determine left/right -> center/other.
                uint color_left, color_right;
                bool have_edge = false;
                float ref_t;

                // Use original tangent to establish consistent left/right
                if (best_t < 0.5 && aa_pl != aa_pr) {
                    color_left = aa_pl; color_right = aa_pr; ref_t = 0.0; have_edge = true;
                } else if (best_t >= 0.5 && aa_nl != aa_nr) {
                    color_left = aa_nr; color_right = aa_nl; ref_t = 1.0; have_edge = true;
                } else if (aa_nl != aa_nr) {
                    color_left = aa_nr; color_right = aa_nl; ref_t = 1.0; have_edge = true;
                } else if (aa_pl != aa_pr) {
                    color_left = aa_pl; color_right = aa_pr; ref_t = 0.0; have_edge = true;
                }

                if (!have_edge) {
                    imageStore(output_img, ivec2(opx, opy), vec4(
                        float((center_color >> 16u) & 0xFFu) / 255.0,
                        float((center_color >> 8u) & 0xFFu) / 255.0,
                        float(center_color & 0xFFu) / 255.0, 1.0));
                } else {
                    // Determine which side of the boundary is "left" vs "right"
                    // using the original normal orientation
                    vec2 orig_tang = beval_deriv(rd.orig_prev, rd.orig_pos, rd.orig_next, ref_t);
                    vec2 orig_norm = vec2(-orig_tang.y, orig_tang.x);
                    bool flip = dot(normal, orig_norm) < 0.0;
                    uint pos_side = flip ? color_right : color_left;
                    uint neg_side = flip ? color_left : color_right;

                    // If both sides are the same color, no AA needed
                    if (pos_side == neg_side) {
                        imageStore(output_img, ivec2(opx, opy), vec4(
                            float((center_color >> 16u) & 0xFFu) / 255.0,
                            float((center_color >> 8u) & 0xFFu) / 255.0,
                            float(center_color & 0xFFu) / 255.0, 1.0));
                    } else {
                        // Coverage: pixel width projected onto normal direction
                        float pw = inv_scale;
                        float proj_w = pw * (abs(normal.x) + abs(normal.y));
                        float frac = clamp(0.5 + d / proj_w, 0.0, 1.0);

                        float r = frac * float((pos_side >> 16u) & 0xFFu) + (1.0 - frac) * float((neg_side >> 16u) & 0xFFu);
                        float g = frac * float((pos_side >> 8u) & 0xFFu) + (1.0 - frac) * float((neg_side >> 8u) & 0xFFu);
                        float b = frac * float(pos_side & 0xFFu) + (1.0 - frac) * float(neg_side & 0xFFu);
                        imageStore(output_img, ivec2(opx, opy), vec4(r / 255.0, g / 255.0, b / 255.0, 1.0));
                    }
                }
            }
        }
    }

}
