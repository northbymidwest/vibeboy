#version 450

// EPX / Scale2x / Scale4x compute shader — pixel-art scaling by Eric Johnston.
// Comparisons use packed u32 colors for exact integer matching.

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, set = 0, binding = 0) readonly buffer PixelBuf {
    uint pixels[];
};

layout(set = 1, binding = 0, rgba8) writeonly uniform image2D output_img;

layout(std140, set = 2, binding = 0) uniform Uniforms {
    uint src_w;
    uint src_h;
    uint out_w;
    uint out_h;
    uint iscale;  // 2 or 4
    uint _pad0;
    uint _pad1;
    uint _pad2;
};

vec4 unpack(uint c) {
    return vec4(
        float((c >> 16u) & 0xFFu) / 255.0,
        float((c >> 8u)  & 0xFFu) / 255.0,
        float( c         & 0xFFu) / 255.0,
        1.0
    );
}

uint fetch(ivec2 coord) {
    coord = clamp(coord, ivec2(0), ivec2(int(src_w) - 1, int(src_h) - 1));
    return pixels[coord.y * int(src_w) + coord.x];
}

uint epx(uint p, uint a, uint b, uint c, uint d, int sx, int sy) {
    if (sx == 0 && sy == 0) return (c==a && c!=d && a!=b) ? a : p;
    if (sx == 1 && sy == 0) return (a==b && a!=c && b!=d) ? b : p;
    if (sx == 0 && sy == 1) return (d==c && d!=b && c!=a) ? c : p;
    return (b==d && b!=a && d!=c) ? d : p;
}

uint epx_at(ivec2 pos) {
    ivec2 src = pos / 2;
    ivec2 sub = pos - src * 2;
    uint p = fetch(src);
    uint a = fetch(src + ivec2(0, -1));
    uint b = fetch(src + ivec2(1, 0));
    uint c = fetch(src + ivec2(-1, 0));
    uint d = fetch(src + ivec2(0, 1));
    return epx(p, a, b, c, d, sub.x, sub.y);
}

void main() {
    uint opx = gl_GlobalInvocationID.x;
    uint opy = gl_GlobalInvocationID.y;
    if (opx >= out_w || opy >= out_h) return;

    // Integer mapping: output pixel to source pixel + sub-pixel position
    int isc = int(iscale);
    ivec2 out_pos = ivec2(opx, opy);
    ivec2 src_i = clamp(out_pos / isc, ivec2(0), ivec2(int(src_w) - 1, int(src_h) - 1));
    ivec2 sub = out_pos - src_i * isc;

    uint result;
    if (iscale == 2u) {
        uint p = fetch(src_i);
        uint a = fetch(src_i + ivec2(0, -1));
        uint b = fetch(src_i + ivec2(1, 0));
        uint c = fetch(src_i + ivec2(-1, 0));
        uint d = fetch(src_i + ivec2(0, 1));
        result = epx(p, a, b, c, d, sub.x, sub.y);
    } else {
        ivec2 mid_pos = src_i * 2 + sub / 2;
        ivec2 sub4 = sub - (sub / 2) * 2;
        uint p = epx_at(mid_pos);
        uint a = epx_at(mid_pos + ivec2(0, -1));
        uint b = epx_at(mid_pos + ivec2(1, 0));
        uint c = epx_at(mid_pos + ivec2(-1, 0));
        uint d = epx_at(mid_pos + ivec2(0, 1));
        result = epx(p, a, b, c, d, sub4.x, sub4.y);
    }

    imageStore(output_img, ivec2(opx, opy), unpack(result));
}
