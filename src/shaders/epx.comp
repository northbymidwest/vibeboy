#version 450

// EPX / Scale2x / Scale4x compute shader — pixel-art scaling by Eric Johnston.

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, set = 0, binding = 0) readonly buffer PixelBuf {
    uint pixels[];
};

layout(set = 1, binding = 0, rgba8) writeonly uniform image2D output_img;

layout(std140, set = 2, binding = 0) uniform Uniforms {
    uint src_w;
    uint src_h;
    uint out_w;
    uint out_h;
    uint iscale;  // 2 or 4
    uint _pad0;
    uint _pad1;
    uint _pad2;
};

vec4 unpack(uint c) {
    return vec4(
        float((c >> 16u) & 0xFFu) / 255.0,
        float((c >> 8u)  & 0xFFu) / 255.0,
        float( c         & 0xFFu) / 255.0,
        1.0
    );
}

vec4 fetch(ivec2 coord) {
    coord = clamp(coord, ivec2(0), ivec2(int(src_w) - 1, int(src_h) - 1));
    return unpack(pixels[coord.y * int(src_w) + coord.x]);
}

vec4 epx(vec4 p, vec4 a, vec4 b, vec4 c, vec4 d, int sx, int sy) {
    if (sx == 0 && sy == 0) return (c==a && c!=d && a!=b) ? a : p;
    if (sx == 1 && sy == 0) return (a==b && a!=c && b!=d) ? b : p;
    if (sx == 0 && sy == 1) return (d==c && d!=b && c!=a) ? c : p;
    return (b==d && b!=a && d!=c) ? d : p;
}

vec4 epx_at(ivec2 pos) {
    ivec2 src = pos / 2;
    ivec2 sub = pos - src * 2;
    vec4 p = fetch(src);
    vec4 a = fetch(src + ivec2(0, -1));
    vec4 b = fetch(src + ivec2(1, 0));
    vec4 c = fetch(src + ivec2(-1, 0));
    vec4 d = fetch(src + ivec2(0, 1));
    return epx(p, a, b, c, d, sub.x, sub.y);
}

void main() {
    uint opx = gl_GlobalInvocationID.x;
    uint opy = gl_GlobalInvocationID.y;
    if (opx >= out_w || opy >= out_h) return;

    // Map output pixel to source pixel + sub-pixel
    float inv_scale = float(src_w) / float(out_w);
    vec2 src_coord = (vec2(opx, opy) + 0.5) * inv_scale;
    ivec2 src_i = clamp(ivec2(floor(src_coord)), ivec2(0), ivec2(int(src_w) - 1, int(src_h) - 1));
    vec2 frac_val = src_coord - vec2(src_i);
    ivec2 sub = clamp(ivec2(floor(frac_val * float(iscale))), ivec2(0), ivec2(int(iscale) - 1));

    vec4 result;
    if (iscale == 2u) {
        vec4 p = fetch(src_i);
        vec4 a = fetch(src_i + ivec2(0, -1));
        vec4 b = fetch(src_i + ivec2(1, 0));
        vec4 c = fetch(src_i + ivec2(-1, 0));
        vec4 d = fetch(src_i + ivec2(0, 1));
        result = epx(p, a, b, c, d, sub.x, sub.y);
    } else {
        ivec2 mid_pos = src_i * 2 + sub / 2;
        ivec2 sub4 = sub - (sub / 2) * 2;
        vec4 p = epx_at(mid_pos);
        vec4 a = epx_at(mid_pos + ivec2(0, -1));
        vec4 b = epx_at(mid_pos + ivec2(1, 0));
        vec4 c = epx_at(mid_pos + ivec2(-1, 0));
        vec4 d = epx_at(mid_pos + ivec2(0, 1));
        result = epx(p, a, b, c, d, sub4.x, sub4.y);
    }

    imageStore(output_img, ivec2(opx, opy), result);
}
