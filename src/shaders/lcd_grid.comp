#version 450

// LCD grid effect — simulates subpixel structure of an LCD panel.
// Each source pixel is rendered with visible R/G/B subpixel columns
// and inter-pixel gaps.

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, set = 0, binding = 0) readonly buffer PixelBuf {
    uint pixels[];
};

layout(set = 1, binding = 0, rgba8) writeonly uniform image2D output_img;

layout(std140, set = 2, binding = 0) uniform Uniforms {
    uint src_w;
    uint src_h;
    uint out_w;
    uint out_h;
    uint iscale;
    uint _pad0;
    uint _pad1;
    uint _pad2;
};

const float BLEED = 0.12;
const float BOOST = 2.2;
const float GAP_BRIGHTNESS = 0.08;
const float HGAP_BRIGHTNESS = 0.12;

vec4 fetch(ivec2 coord) {
    coord = clamp(coord, ivec2(0), ivec2(int(src_w) - 1, int(src_h) - 1));
    uint c = pixels[coord.y * int(src_w) + coord.x];
    return vec4(
        float((c >> 16u) & 0xFFu) / 255.0,
        float((c >> 8u)  & 0xFFu) / 255.0,
        float( c         & 0xFFu) / 255.0,
        1.0
    );
}

void main() {
    uint opx = gl_GlobalInvocationID.x;
    uint opy = gl_GlobalInvocationID.y;
    if (opx >= out_w || opy >= out_h) return;

    uint scale = max(iscale, 3u);

    // Source pixel and position within the scaled block
    ivec2 src_i = ivec2(opx / scale, opy / scale);
    uint px = opx % scale;  // column within pixel block
    uint py = opy % scale;  // row within pixel block

    vec4 c = fetch(src_i);

    // Determine subpixel phase: map column to R(0), G(1), B(2)
    uint phase = (px * 3u) / scale;

    // Vertical gap: last column (only if scale > 3)
    bool is_vgap = (scale > 3u) && (px == scale - 1u);
    // Horizontal gap: last row
    bool is_hgap = (py == scale - 1u);

    vec3 rgb;

    if (is_vgap || is_hgap) {
        // Gap regions: very dim
        rgb = c.rgb * GAP_BRIGHTNESS;
    } else {
        // Subpixel mask: amplify the primary channel, bleed the others
        vec3 mask;
        if (phase == 0u)      mask = vec3(1.0, BLEED, BLEED);
        else if (phase == 1u) mask = vec3(BLEED, 1.0, BLEED);
        else                  mask = vec3(BLEED, BLEED, 1.0);

        rgb = min(c.rgb * mask * BOOST, vec3(1.0));
    }

    imageStore(output_img, ivec2(opx, opy), vec4(rgb, 1.0));
}
