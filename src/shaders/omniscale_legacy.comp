#version 450

// OmniScale Legacy — diagonal-aware pixel-art upscaler with quantized fallback.
//
// Algorithm designed by Lior Halphon.
//
// Detects and preserves diagonal edges in 2x2 source quads. When a diagonal
// is found, the sub-pixel position along that diagonal picks the winning color.
// No diagonal → bilinear blend quantized to the nearest source color.

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, set = 0, binding = 0) readonly buffer PixelBuf { uint pixels[]; };
layout(set = 1, binding = 0, rgba8) writeonly uniform image2D output_img;
layout(std140, set = 2, binding = 0) uniform Uniforms {
    uint src_w;
    uint src_h;
    uint out_w;
    uint out_h;
};

vec4 unpack(uint c) {
    return vec4(float((c >> 16u) & 0xFFu) / 255.0,
                float((c >> 8u) & 0xFFu) / 255.0,
                float(c & 0xFFu) / 255.0,
                1.0);
}

vec4 fetch(ivec2 coord) {
    coord = clamp(coord, ivec2(0), ivec2(int(src_w) - 1, int(src_h) - 1));
    return unpack(pixels[coord.y * int(src_w) + coord.x]);
}

// Manhattan RGB distance.
float channel_dist(vec4 a, vec4 b) {
    vec3 d = abs(a.rgb - b.rgb);
    return (d.r + d.g + d.b) * 255.0;
}

// Perceptual similarity — threshold of 15 in Manhattan RGB.
bool alike(vec4 a, vec4 b) {
    return a == b || channel_dist(a, b) < 15.0;
}

// Fixed-point blend: t in [0, 1].
vec4 blend(vec4 a, vec4 b, float t) {
    return mix(a, b, clamp(t, 0.0, 1.0));
}

// Module-scope globals for array parameters (naga WGSL compatibility).
vec4 g_c[4];

// Pick color for a rising (/) diagonal.
vec4 pick_rising(float fx, float fy) {
    float s = fx + fy;
    if (s < 0.5) return g_c[0];
    if (s > 1.5) return g_c[3];
    return g_c[2]; // on-diagonal
}

// Pick color for a falling (\) diagonal.
vec4 pick_falling(float fx, float fy) {
    float d = 1.0 - fx + fy;
    if (d < 0.5) return g_c[1];
    if (d > 1.5) return g_c[2];
    return g_c[0]; // on-diagonal
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= int(out_w) || pos.y >= int(out_h)) return;

    // Map output pixel to source coordinates (centered on pixel boundaries).
    vec2 src_coord = (vec2(pos) + 0.5) / vec2(out_w, out_h) * vec2(src_w, src_h) - 0.5;
    ivec2 src_i = ivec2(floor(src_coord));
    vec2 f = src_coord - vec2(src_i); // fractional [0, 1)

    // Sample the 2x2 quad.
    g_c[0] = fetch(src_i);               // top-left
    g_c[1] = fetch(src_i + ivec2(1, 0)); // top-right
    g_c[2] = fetch(src_i + ivec2(0, 1)); // bottom-left
    g_c[3] = fetch(src_i + ivec2(1, 1)); // bottom-right

    vec4 result;

    // Diagonal detection.
    bool rising  = alike(g_c[2], g_c[1]); // / diagonal
    bool falling = alike(g_c[0], g_c[3]); // \ diagonal

    if (rising && falling) {
        if (alike(g_c[0], g_c[2])) {
            // All four similar — flat fill
            result = g_c[0];
        } else {
            // Both diagonals — 4x4 neighborhood vote to break tie
            int bias = 0;
            for (int row = -1; row < 3; row++) {
                for (int col = -1; col < 3; col++) {
                    vec4 n = fetch(src_i + ivec2(col, row));
                    if (alike(n, g_c[0])) bias++;
                    if (alike(n, g_c[2])) bias--;
                }
            }
            if (bias < 0) {
                result = pick_falling(f.x, f.y);
            } else if (bias > 0) {
                result = pick_rising(f.x, f.y);
            } else {
                // Tie — average both
                result = blend(pick_falling(f.x, f.y), pick_rising(f.x, f.y), 0.5);
            }
        }
    } else if (rising) {
        result = pick_rising(f.x, f.y);
    } else if (falling) {
        result = pick_falling(f.x, f.y);
    } else {
        // No diagonal — bilinear, then quantize to nearest source color
        vec4 top = blend(g_c[0], g_c[1], f.x);
        vec4 bot = blend(g_c[2], g_c[3], f.x);
        vec4 mixed = blend(top, bot, f.y);

        float d0 = channel_dist(mixed, g_c[0]);
        float d1 = channel_dist(mixed, g_c[1]);
        float d2 = channel_dist(mixed, g_c[2]);
        float d3 = channel_dist(mixed, g_c[3]);
        float min_d = min(min(d0, d1), min(d2, d3));

        if (d0 == min_d) result = g_c[0];
        else if (d1 == min_d) result = g_c[1];
        else if (d2 == min_d) result = g_c[2];
        else result = g_c[3];
    }

    imageStore(output_img, pos, result);
}
