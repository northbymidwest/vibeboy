#version 450

layout(local_size_x = 16, local_size_y = 16) in;

// Edge segments: x0, y0, x1, y1, left_color(uint), right_color(uint) = 6 floats (24 bytes)
// Padded to 8 floats (32 bytes) for alignment.
layout(std430, set = 0, binding = 0) readonly buffer EdgeBuf {
    float edge_data[];
};

// Spatial grid: flat packed array of edge indices.
layout(std430, set = 0, binding = 1) readonly buffer GridDataBuf {
    uint grid_data[];
};

// Grid cell offsets: cell_offset[i] = start index into grid_data for cell i.
// cell_offset[n_cells] = total entries. So n_cells+1 entries.
layout(std430, set = 0, binding = 2) readonly buffer GridOffsetBuf {
    uint cell_offset[];
};

// NN base layer: nearest-neighbor upscaled pixel colors.
layout(std430, set = 0, binding = 3) readonly buffer NNBuf {
    uint nn_colors[];
};

// Output texture
layout(set = 1, binding = 0, rgba8) writeonly uniform image2D output_img;

// Uniforms
layout(std140, set = 2, binding = 0) uniform Uniforms {
    uint out_w;
    uint out_h;
    float grid_cell_size;
    uint grid_w;
    float override_dist_sq;
    uint _pad0;
    uint _pad1;
    uint _pad2;
};

// Edge field accessors (32 bytes = 8 floats per edge)
float edge_x0(uint i)          { return edge_data[i * 8u + 0u]; }
float edge_y0(uint i)          { return edge_data[i * 8u + 1u]; }
float edge_x1(uint i)          { return edge_data[i * 8u + 2u]; }
float edge_y1(uint i)          { return edge_data[i * 8u + 3u]; }
uint  edge_left_color(uint i)  { return floatBitsToUint(edge_data[i * 8u + 4u]); }
uint  edge_right_color(uint i) { return floatBitsToUint(edge_data[i * 8u + 5u]); }

void main() {
    uint px = gl_GlobalInvocationID.x;
    uint py = gl_GlobalInvocationID.y;
    if (px >= out_w || py >= out_h) return;

    float cx = float(px) + 0.5;
    float cy = float(py) + 0.5;

    uint nn_color = nn_colors[py * out_w + px];

    // Grid cell lookup
    uint gx = min(uint(cx / grid_cell_size), grid_w - 1u);
    uint grid_h_calc = (out_h + uint(grid_cell_size) - 1u) / uint(grid_cell_size);
    uint gy = min(uint(cy / grid_cell_size), grid_h_calc - 1u);
    uint ci = gy * grid_w + gx;

    uint start = cell_offset[ci];
    uint end = cell_offset[ci + 1u];

    float best_dist = override_dist_sq;
    float best_cross = 0.0;
    uint best_left = 0u;
    uint best_right = 0u;
    bool found = false;

    for (uint idx = start; idx < end; idx++) {
        uint ei = grid_data[idx];

        uint lc = edge_left_color(ei);
        uint rc = edge_right_color(ei);

        // NN-color constraint
        if (lc != nn_color && rc != nn_color) continue;

        float ex = edge_x1(ei) - edge_x0(ei);
        float ey = edge_y1(ei) - edge_y0(ei);
        float len_sq = ex * ex + ey * ey;

        float dist_sq;
        float cross;

        if (len_sq < 1e-10) {
            float dx = cx - edge_x0(ei);
            float dy = cy - edge_y0(ei);
            dist_sq = dx * dx + dy * dy;
            cross = 0.0;
        } else {
            float t = ((cx - edge_x0(ei)) * ex + (cy - edge_y0(ei)) * ey) / len_sq;
            t = clamp(t, 0.0, 1.0);
            float closex = edge_x0(ei) + t * ex;
            float closey = edge_y0(ei) + t * ey;
            float dx = cx - closex;
            float dy = cy - closey;
            dist_sq = dx * dx + dy * dy;
            cross = ex * (cy - edge_y0(ei)) - ey * (cx - edge_x0(ei));
        }

        if (dist_sq < best_dist) {
            best_dist = dist_sq;
            best_cross = cross;
            best_left = lc;
            best_right = rc;
            found = true;
        }
    }

    uint color;
    if (found) {
        // Positive cross = right side in y-down coords = CellEdge right_color
        color = (best_cross >= 0.0) ? best_right : best_left;
    } else {
        color = nn_color;
    }

    vec4 rgba = vec4(
        float((color >> 16u) & 0xFFu) / 255.0,
        float((color >> 8u) & 0xFFu) / 255.0,
        float(color & 0xFFu) / 255.0,
        1.0
    );
    imageStore(output_img, ivec2(px, py), rgba);
}
